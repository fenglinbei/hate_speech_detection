{
  "data_paths": {
    "input_paths": [
      "data/full/std/train.json",
      "data/full/std/test.json"
    ],
    "output_dir": "data/lexicon/generated/full"
  },
  "candidate_settings": {
    "max_candidates": 1000,
    "max_samples_per_candidate": 5,
    "min_count_for_llm": 1,
    "min_hate_count_for_llm": 1,
    "zh_min_ngram": 2,
    "zh_max_ngram": 4,
    "zh_token_max_ngram": 4,
    "use_jieba": true,
    "keep_all_content_ngrams": false,
    "suppressed_reject_hints": [
      "broken_fragment",
      "generic_word",
      "generic_phrase",
      "singleton_ngram",
      "substring_fragment"
    ],
    "en_max_ngram": 3,
    "max_text_chars_per_record": 800
  },
  "web_settings": {
    "backend": "search_api",
    "api_base": "https://api.tavily.com/search",
    "api_method": "POST",
    "api_query_param": "query",
    "api_key_env": "TAVILY_API_KEY",
    "api_key_header": "Authorization",
    "api_key_header_prefix": "Bearer ",
    "api_extra_params": {
      "max_results": 3,
      "search_depth": "basic"
    },
    "api_results_path": "results"
  },
  "llm_settings": {
    "backend": "deepseek",
    "api_base": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-v4-pro",
    "json_mode": true,
    "thinking": {
      "type": "disabled"
    },
    "reasoning_effort": null,
    "stream": false,
    "temperature": 0,
    "send_temperature": true,
    "max_tokens": 1024,
    "timeout": 120
  }
,
  "inclusion": {
    "confidence_threshold": 0.65,
    "single_mention_confidence": 0.85,
    "min_count": 2,
    "ambiguous_requires_nonhateful_meaning": true
  },
  "runtime_settings": {
    "show_progress": true,
    "log_level": "INFO",
    "debug": false,
    "debug_dir": null,
    "resume": true,
    "resume_require_config_match": true,
    "llm_failure_policy": "reject_candidate",
    "max_llm_failures": 50,
    "max_consecutive_llm_failures": 8
  }
}
