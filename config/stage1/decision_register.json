      "render_policy": "category-free-terminology-evidence/v1",
      "entry_id_policy": "category-free-visible-semantics/lex-v2",
      "model_visible_fields": ["term", "definition", "usage_notes", "ambiguity_notes", "variants"],
      "definition_policy": "semantic-meaning-and-usage-not-task-taxonomy-copy/v1",
      "forbidden_entry_fields": ["annotation_count", "categories", "category", "category_counts", "category_purity", "hate_count", "hate_precision", "hateful", "label", "labels", "log_odds", "non_hate_count", "nonhate_penalty", "primary_category", "targeted_group"],
