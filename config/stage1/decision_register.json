      "sensitivity": ["NLD"]
    },
    "D6_cf_selector": {
      "primary": "model-independent-blind-approved-foil",
      "sensitivity": "base-reference-hardest"
    },
    "D7_training_seeds": {
      "formal": [42, 43, 44],
      "pilot": [42],
      "matched_across_roles": true,
