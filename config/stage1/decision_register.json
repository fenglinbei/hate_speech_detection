        "versioned-web-evidence",
        "human-terminology-queue"
      ],
      "live_web_during_formal_inference": false,
      "library_updates_require_new_context_build": true,
      "term_match_does_not_imply_hate": true,
      "targeted_group_and_hateful_independent": true,
