{
  "schema_version": "stage1-generation-profile/v1",
  "profile_name": "stage1-legacy-engineering-smoke-greedy",
  "backend": "transformers",
  "ordered_conditions": ["C0", "CL", "CD", "CLD", "PL", "PD"],
  "model_runtime": {
    "dtype": "bfloat16",
    "tensor_parallel_size": 1,
    "max_model_len": 2048,
    "max_prompt_tokens": 1792,
    "completion_reserve_tokens": 256,
    "overflow_policy": "hard-fail-no-truncation",
    "trust_remote_code": true,
    "thinking_mode": false
  },
  "sampling": {
    "do_sample": false,
    "temperature": 0.0,
    "top_p": 1.0,
    "top_k": -1,
    "min_p": 0.0,
    "max_new_tokens": 256,
    "n": 1,
    "best_of": 1,
    "seed": 42,
    "stop_policy": "tokenizer-eos-only"
  },
  "failure_policy": {
    "max_attempts": 1,
    "fallback_generation": false,
    "preserve_raw_failure": true,
    "require_complete_paired_block": true
  }
}
