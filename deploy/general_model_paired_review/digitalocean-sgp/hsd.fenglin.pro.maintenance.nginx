# Keep the public endpoint unavailable until the authoritative session is ready.
server {
    listen 80;
    listen [::]:80;
    server_name hsd.fenglin.pro;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/hsd-acme;
        default_type text/plain;
    }

    location / {
        return 301 https://hsd.fenglin.pro$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hsd.fenglin.pro;

    ssl_certificate /etc/letsencrypt/live/hsd.fenglin.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hsd.fenglin.pro/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;
    add_header Retry-After 300 always;

    location / {
        default_type text/plain;
        return 503 "The review service is being prepared. Please continue using the existing private review entry until migration is complete.\n";
    }
}
