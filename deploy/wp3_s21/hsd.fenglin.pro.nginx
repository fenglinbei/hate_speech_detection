server {
    listen 80;
    listen [::]:80;
    server_name hsd.fenglin.pro;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }

    location / {
        return 301 https://hsd.fenglin.pro$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hsd.fenglin.pro;

    ssl_certificate /etc/letsencrypt/live/hsd.fenglin.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hsd.fenglin.pro/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:HSDReviewTLS:10m;
    ssl_session_tickets off;

    auth_basic "WP3 S2.1 development review";
    auth_basic_user_file /etc/nginx/.htpasswd-hsd-wp3-review;

    access_log /var/log/nginx/hsd.fenglin.pro.access.log;
    error_log /var/log/nginx/hsd.fenglin.pro.error.log warn;

    client_max_body_size 128k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
