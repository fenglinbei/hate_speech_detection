{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stage1/schemas/stage1_generation_record_v1.schema.json",
  "title": "Stage 1 immutable free-generation row",
  "type": "object",
  "required": [
    "schema_version",
    "generation_run_id",
    "row_ordinal",
    "query_ordinal",
    "condition_ordinal",
    "model_key",
    "model_role",
    "split",
    "condition",
    "query_id",
    "content",
    "content_sha256",
    "gold",
    "gold_sha256",
    "context_record_sha256",
    "prompt_sha256",
    "prompt_tokens",
    "control_record_sha256",
    "attempt_count",
    "runner_status",
    "finish_reason",
    "backend_stop_reason",
    "generated_token_ids",
    "completion_tokens",
    "total_tokens",
    "raw_output",
    "raw_output_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "stage1-generation-record/v1"},
    "generation_run_id": {"type": "string", "pattern": "^gen-[0-9a-f]{64}$"},
    "row_ordinal": {"type": "integer", "minimum": 0},
    "query_ordinal": {"type": "integer", "minimum": 0},
    "condition_ordinal": {"type": "integer", "minimum": 0, "maximum": 5},
    "model_key": {"type": "string", "pattern": "^(?:(?:M_LD|M_drop)/seed-[0-9]+|M_legacy/smoke)$"},
    "model_role": {"enum": ["M_LD", "M_drop", "legacy-smoke-only"]},
    "split": {"enum": ["train", "dev", "test"]},
    "condition": {"enum": ["C0", "CL", "CD", "CLD", "PL", "PD"]},
    "query_id": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "gold": {"type": "array"},
    "gold_sha256": {"$ref": "#/$defs/sha256"},
    "context_record_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_tokens": {"type": "integer", "minimum": 1},
    "control_record_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "attempt_count": {"const": 1},
    "runner_status": {"enum": ["ok", "length"]},
    "finish_reason": {"enum": ["eos", "length", "fixture"]},
    "backend_stop_reason": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "generated_token_ids": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "completion_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 1},
    "raw_output": {"type": "string"},
    "raw_output_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
