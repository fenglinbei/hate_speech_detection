{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_run_ref_map_v1.schema.json",
  "title": "Exact registry-ordered evaluation and margin locator map",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "stage1-run-ref-map/v1"},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_key", "evaluation_ref", "margin_ref"],
        "properties": {
          "model_key": {"type": "string", "minLength": 1},
          "evaluation_ref": {"type": "string", "minLength": 1},
          "margin_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
