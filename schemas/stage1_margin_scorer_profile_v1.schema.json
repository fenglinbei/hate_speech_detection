{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_margin_scorer_profile_v1.schema.json",
  "title": "Stage 1 frozen local-HF field-margin scorer profile",
  "type": "object",
  "required": [
    "schema_version", "profile_name", "backend", "ordered_conditions",
    "fields", "runtime", "tokenization", "record_outputs",
    "aggregation", "eligibility"
  ],
  "properties": {
    "schema_version": {"const": "stage1-margin-scorer-profile/v1"},
    "profile_name": {"const": "stage1-local-hf-field-margin-v1"},
    "backend": {"const": "local-huggingface-causal-lm"},
    "ordered_conditions": {
      "const": ["C0", "CL", "CD", "CLD", "PL", "PD"]
    },
    "fields": {
      "const": ["target", "argument", "targeted_group", "hateful"]
    },
    "runtime": {
      "type": "object",
      "required": [
        "dtype", "device_map", "batch_unit", "batch_size",
        "max_sequence_tokens", "truncation_allowed", "trust_remote_code",
        "right_padding", "position_ids", "log_softmax_dtype",
        "thinking_mode"
      ],
      "properties": {
        "dtype": {"const": "bfloat16"},
        "device_map": {"const": "auto"},
        "batch_unit": {"const": "gold-cf-pair"},
        "batch_size": {"const": 1},
        "max_sequence_tokens": {"const": 2048},
        "truncation_allowed": {"const": false},
        "trust_remote_code": {"const": false},
        "right_padding": {"const": true},
        "position_ids": {
          "const": "attention-mask-cumsum-minus-one-zero-on-padding/v1"
        },
        "log_softmax_dtype": {"const": "float32"},
        "thinking_mode": {"const": false}
      },
      "additionalProperties": false
    },
    "tokenization": {
      "type": "object",
      "required": [
        "prompt_response_segmentation", "span_mask",
        "score_complete_json_value_literal", "causal_shift",
        "record_boundary_crossing"
      ],
      "properties": {
        "prompt_response_segmentation": {
          "const": "separate-no-special-tokens/v1"
        },
        "span_mask": {"const": "minimal-overlap-cover/v1"},
        "score_complete_json_value_literal": {"const": true},
        "causal_shift": {"const": "logits-minus-last-vs-input-minus-first"},
        "record_boundary_crossing": {"const": true}
      },
      "additionalProperties": false
    },
    "record_outputs": {
      "const": [
        "token_ids", "token_count", "character_span", "token_span",
        "sum_logprob", "mean_logprob", "left_boundary_crossing",
        "right_boundary_crossing"
      ]
    },
    "aggregation": {
      "type": "object",
      "required": [
        "primary_token_aggregation", "sensitivity_token_aggregation",
        "tuple_aggregation", "query_aggregation", "hateful_interpretation"
      ],
      "properties": {
        "primary_token_aggregation": {"const": "mean"},
        "sensitivity_token_aggregation": {"const": "sum"},
        "tuple_aggregation": {"const": "equal-weight-within-query"},
        "query_aggregation": {"const": "equal-weight"},
        "hateful_interpretation": {"const": "gold-prefix-conditional"}
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": [
        "mask_timing", "mask_shared_across_conditions_and_models",
        "overflow_policy"
      ],
      "properties": {
        "mask_timing": {"const": "frozen-before-scoring"},
        "mask_shared_across_conditions_and_models": {"const": true},
        "overflow_policy": {
          "const": "hard-fail-and-common-complete-case-mask"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
