{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/wp3_g3_public_source_bundle_v2.schema.json",
  "title": "WP3 G3 public source bundle v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "catalog_id",
    "catalog_sha256",
    "catalog_schema_sha256",
    "acquisition_receipt_id",
    "acquisition_receipt_sha256",
    "acquisition_receipt_schema_sha256",
    "components_sha256",
    "components_schema_sha256",
    "source_count",
    "component_count",
    "normalized_component_count",
    "candidate_projection_count",
    "source_policy",
    "reference_role",
    "scope",
    "scientific_eligible",
    "sealed",
    "builder_implementation_sha256",
    "source_bundle_id"
  ],
  "properties": {
    "schema_version": {"const": "wp3-g3-public-source-bundle/v2"},
    "artifact_kind": {"const": "wp3-g3-public-source-bundle"},
    "catalog_id": {"const": "wp3-g3-fixed-public-priors/v2"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_schema_sha256": {"$ref": "#/$defs/sha256"},
    "acquisition_receipt_id": {"type": "string", "pattern": "^wp3g3acq-[0-9a-f]{64}$"},
    "acquisition_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "acquisition_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "components_sha256": {"$ref": "#/$defs/sha256"},
    "components_schema_sha256": {"$ref": "#/$defs/sha256"},
    "source_count": {"type": "integer", "minimum": 1},
    "component_count": {"type": "integer", "minimum": 1},
    "normalized_component_count": {"type": "integer", "minimum": 1},
    "candidate_projection_count": {"type": "integer", "minimum": 0},
    "source_policy": {"const": "closed-42-target-offline-two-dependency/v2"},
    "reference_role": {"const": "form-only-label-free-non-lexicon"},
    "scope": {"const": "development-only"},
    "scientific_eligible": {"const": false},
    "sealed": {"const": false},
    "builder_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "source_bundle_id": {"type": "string", "pattern": "^wp3g3sources-[0-9a-f]{64}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
