{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stage1/schemas/stage1_model_registry_v1.schema.json",
  "title": "Stage 1 exact-slot model registry",
  "type": "object",
  "required": [
    "schema_version", "model_registry_id", "scope", "scientific_eligible",
    "training_plan_dependency", "ordered_model_keys", "entries", "id_inputs"
  ],
  "properties": {
    "schema_version": {"const": "stage1-model-registry/v1"},
    "model_registry_id": {"type": "string", "pattern": "^mreg-[0-9a-f]{64}$"},
    "scope": {"enum": ["engineering-smoke", "pilot", "formal"]},
    "scientific_eligible": {"type": "boolean"},
    "training_plan_dependency": {"$ref": "#/$defs/dependency"},
    "ordered_model_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/model_key"}
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "id_inputs": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_key": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "dependency": {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "artifact_id", "payload_manifest_sha256", "logical_repo_path"],
      "properties": {
        "schema_version": {"const": "stage1-dependency-ref/v1"},
        "artifact_kind": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "payload_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "logical_repo_path": {"type": "string", "minLength": 1, "not": {"pattern": "^/|(^|/)\\.\\.(/|$)"}}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "model_key", "role", "seed", "model_dependency", "model_artifact_id",
        "checkpoint_format", "model_scientific_eligible"
      ],
      "properties": {
        "model_key": {"$ref": "#/$defs/model_key"},
        "role": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "model_dependency": {"$ref": "#/$defs/dependency"},
        "model_artifact_id": {"type": "string", "pattern": "^mdl-[0-9a-f]{64}$"},
        "checkpoint_format": {"enum": ["base", "full", "adapter"]},
        "model_scientific_eligible": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
