{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_analysis_artifact_v1.schema.json",
  "title": "Immutable Stage 1 factorial-analysis metadata",
  "type": "object",
  "required": [
    "schema_version", "analysis_id", "registry_scope", "mode", "split",
    "sealing_status", "scientific_eligible", "ordered_model_keys",
    "ordered_query_ids_sha256", "query_count", "ordered_conditions",
    "bootstrap_stream_derivation", "bootstrap_replicates", "bootstrap_seed",
    "holm_families", "gate_policy", "id_inputs", "observed_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "stage1-factorial-analysis/v1"},
    "analysis_id": {"type": "string", "pattern": "^ana-[0-9a-f]{64}$"},
    "registry_scope": {"enum": ["engineering-smoke", "pilot", "formal"]},
    "mode": {"enum": ["engineering-smoke", "pilot", "confirmatory"]},
    "split": {"enum": ["dev", "test"]},
    "sealing_status": {"enum": ["unsealed-dev", "sealed-test"]},
    "scientific_eligible": {"type": "boolean"},
    "ordered_model_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ordered_query_ids_sha256": {"$ref": "#/$defs/sha256"},
    "query_count": {"type": "integer", "minimum": 1},
    "ordered_conditions": {"$ref": "#/$defs/conditions"},
    "bootstrap_stream_derivation": {"const": "sha256-seed-family-replicate/v1"},
    "bootstrap_replicates": {"type": "integer", "minimum": 1},
    "bootstrap_seed": {"type": "integer"},
    "holm_families": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "gate_policy": {"type": "object"},
    "id_inputs": {"type": "object"},
    "observed_payload_sha256": {
      "type": "object",
      "required": ["factorial", "bootstrap", "scientific_gate"],
      "properties": {
        "factorial": {"$ref": "#/$defs/sha256"},
        "bootstrap": {"$ref": "#/$defs/sha256"},
        "scientific_gate": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditions": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"const": "C0"}, {"const": "CL"}, {"const": "CD"},
        {"const": "CLD"}, {"const": "PL"}, {"const": "PD"}
      ],
      "items": false
    }
  }
}
