{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/wp3_g3_frozen_source_input_v1.schema.json",
  "title": "WP3 G3 synchronizer-produced frozen source index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshots"],
  "properties": {
    "schema_version": {"const": "wp3-g3-frozen-snapshot-index/v1"},
    "snapshots": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "requested_url", "final_url", "fetched_at", "media_type", "snapshot_file", "body_sha256", "wikimedia_revision_id"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "requested_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "final_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "fetched_at": {"type": "string", "minLength": 1},
          "media_type": {"enum": ["text/html", "text/plain"]},
          "snapshot_file": {"type": "string", "pattern": "^[a-z0-9-]+\\.(html|txt)$"},
          "body_sha256": {"$ref": "#/$defs/sha256"},
          "wikimedia_revision_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
