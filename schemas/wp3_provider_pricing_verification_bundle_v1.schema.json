{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/wp3_provider_pricing_verification_bundle_v1.schema.json",
  "title": "WP3 verified provider pricing bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "scientific_eligible",
    "sealed",
    "pricing_projection",
    "verification_receipt",
    "verification_receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "wp3-provider-pricing-verification-bundle/v1"},
    "scope": {"const": "development-only"},
    "scientific_eligible": {"const": false},
    "sealed": {"const": false},
    "pricing_projection": {"$ref": "#/$defs/pricingProjection"},
    "verification_receipt": {"$ref": "#/$defs/verificationReceipt"},
    "verification_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capturedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,9})?$"
    },
    "ratePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_rmb_per_million", "output_rmb_per_million"],
      "properties": {
        "input_rmb_per_million": {"$ref": "#/$defs/decimal"},
        "output_rmb_per_million": {"$ref": "#/$defs/decimal"}
      }
    },
    "projectionSourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["provider_id"],
            "properties": {"provider_id": {"const": "glm_flash"}}
          },
          "then": {
            "properties": {
              "source_url": {"const": "https://bigmodel.cn/pricing"}
            }
          }
        }
      ],
      "required": ["provider_id", "source_url", "snapshot_sha256"],
      "properties": {
        "provider_id": {"enum": ["glm_flash", "deepseek_flash"]},
        "source_url": {"type": "string", "format": "uri"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pricingProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "currency",
        "captured_at",
        "source_receipts",
        "provider_rates"
      ],
      "properties": {
        "schema_version": {"const": "wp3-provider-pricing-snapshot/v1"},
        "currency": {"const": "RMB"},
        "captured_at": {"$ref": "#/$defs/capturedAt"},
        "source_receipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/projectionSourceReceipt"}
        },
        "provider_rates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glm_flash", "deepseek_flash"],
          "properties": {
            "glm_flash": {"$ref": "#/$defs/ratePair"},
            "deepseek_flash": {"$ref": "#/$defs/ratePair"}
          }
        }
      }
    },
    "ratePolicyApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability_scope", "input_basis", "output_basis"],
      "properties": {
        "applicability_scope": {
          "const": "requested-model-direct-token-tariff-only/v1"
        },
        "input_basis": {"type": "string", "minLength": 1},
        "output_basis": {"type": "string", "minLength": 1}
      }
    },
    "textReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_text_sha256",
        "occurrence_ordinal",
        "start_character",
        "end_character"
      ],
      "properties": {
        "exact_text_sha256": {"$ref": "#/$defs/sha256"},
        "occurrence_ordinal": {"type": "integer", "minimum": 1},
        "start_character": {"type": "integer", "minimum": 0},
        "end_character": {"type": "integer", "minimum": 1}
      }
    },
    "rateReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_text_sha256",
        "occurrence_ordinal",
        "start_character",
        "end_character",
        "numeric_text",
        "normalized_rmb_per_million"
      ],
      "properties": {
        "exact_text_sha256": {"$ref": "#/$defs/sha256"},
        "occurrence_ordinal": {"type": "integer", "minimum": 1},
        "start_character": {"type": "integer", "minimum": 0},
        "end_character": {"type": "integer", "minimum": 1},
        "numeric_text": {"$ref": "#/$defs/decimal"},
        "normalized_rmb_per_million": {"$ref": "#/$defs/decimal"}
      }
    },
    "sourceReplay": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["provider_id"],
            "properties": {"provider_id": {"const": "glm_flash"}}
          },
          "then": {
            "properties": {
              "source_url": {"const": "https://bigmodel.cn/pricing"}
            }
          }
        }
      ],
      "required": [
        "provider_id",
        "requested_model",
        "source_url",
        "snapshot_path",
        "snapshot_sha256",
        "snapshot_size_bytes",
        "captured_at",
        "rate_policy_application",
        "evidence_replay"
      ],
      "properties": {
        "provider_id": {"enum": ["glm_flash", "deepseek_flash"]},
        "requested_model": {"enum": ["glm-5.3-flash", "deepseek-v4-flash"]},
        "source_url": {"type": "string", "format": "uri"},
        "snapshot_path": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "captured_at": {"$ref": "#/$defs/capturedAt"},
        "rate_policy_application": {"$ref": "#/$defs/ratePolicyApplication"},
        "evidence_replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "input_rate", "output_rate"],
          "properties": {
            "model": {"$ref": "#/$defs/textReplay"},
            "input_rate": {"$ref": "#/$defs/rateReplay"},
            "output_rate": {"$ref": "#/$defs/rateReplay"}
          }
        }
      }
    },
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "scientific_eligible",
        "sealed",
        "rate_policy",
        "pricing_evidence_sha256",
        "pricing_projection_sha256",
        "source_replays",
        "network_access_performed",
        "verified",
        "verification_id"
      ],
      "properties": {
        "schema_version": {"const": "wp3-provider-pricing-verification/v1"},
        "scope": {"const": "development-only"},
        "scientific_eligible": {"const": false},
        "sealed": {"const": false},
        "rate_policy": {"const": "wp3-conservative-peak-cache-miss/v1"},
        "pricing_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "pricing_projection_sha256": {"$ref": "#/$defs/sha256"},
        "source_replays": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/sourceReplay"}
        },
        "network_access_performed": {"const": false},
        "verified": {"const": true},
        "verification_id": {
          "type": "string",
          "pattern": "^wp3pricingverify-[0-9a-f]{64}$"
        }
      }
    }
  }
}
