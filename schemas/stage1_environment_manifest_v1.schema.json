{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/stage1_environment_manifest_v1.schema.json",
  "title": "Stage 1 immutable training environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_build_id",
    "python_implementation_version",
    "sorted_installed_distributions",
    "torch_build",
    "cuda_runtime_driver",
    "gpu_architecture",
    "container_image_digest_or_null",
    "conda_explicit_lock_sha256",
    "critical_backend_versions",
    "environment_spec_sha256",
    "capture_policy_version",
    "capture_code_sha256",
    "reproducibility_grade"
  ],
  "properties": {
    "schema_version": {"const": "stage1-environment/v1"},
    "environment_build_id": {"type": "string", "pattern": "^env-[0-9a-f]{64}$"},
    "python_implementation_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "sorted_installed_distributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {"properties": {"installer": {"const": "conda"}}},
          "minContains": 1
        },
        {
          "contains": {"properties": {"installer": {"const": "python"}}},
          "minContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["installer", "name", "version"],
        "properties": {
          "installer": {"enum": ["conda", "python"]},
          "name": {"type": "string", "pattern": "^[a-z0-9_][a-z0-9_.-]*$"},
          "version": {"type": "string", "minLength": 1},
          "direct_url": {"type": "object"},
          "build": {"type": "string", "minLength": 1},
          "build_number": {"type": "integer", "minimum": 0},
          "subdir": {"type": "string", "minLength": 1},
          "package_sha256_or_null": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "package_md5_or_null": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{32}$"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"installer": {"const": "conda"}}},
            "then": {
              "required": [
                "build",
                "build_number",
                "subdir",
                "package_sha256_or_null",
                "package_md5_or_null"
              ],
              "not": {"required": ["direct_url"]},
              "anyOf": [
                {"properties": {"package_sha256_or_null": {"type": "string"}}},
                {"properties": {"package_md5_or_null": {"type": "string"}}}
              ]
            }
          },
          {
            "if": {"properties": {"installer": {"const": "python"}}},
            "then": {
              "properties": {
                "name": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
              },
              "not": {
                "anyOf": [
                  {"required": ["build"]},
                  {"required": ["build_number"]},
                  {"required": ["subdir"]},
                  {"required": ["package_sha256_or_null"]},
                  {"required": ["package_md5_or_null"]}
                ]
              }
            }
          }
        ]
      }
    },
    "torch_build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cuda_version", "git_version", "cudnn_version", "debug_build"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "cuda_version": {"type": ["string", "null"]},
        "git_version": {"type": ["string", "null"]},
        "cudnn_version": {"type": ["integer", "null"]},
        "debug_build": {"type": "boolean"}
      }
    },
    "cuda_runtime_driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["torch_cuda_version", "nvidia_driver_version"],
      "properties": {
        "torch_cuda_version": {"type": ["string", "null"]},
        "nvidia_driver_version": {"type": "string", "minLength": 1}
      }
    },
    "gpu_architecture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "compute_capability", "memory_total_mib", "count"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "compute_capability": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "memory_total_mib": {"type": "integer", "minimum": 1},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "container_image_digest_or_null": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "conda_explicit_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "critical_backend_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["accelerate", "datasets", "deepspeed", "flash-attn", "numpy", "pandas", "scikit-learn", "torch", "transformers", "vllm"]
    },
    "environment_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_policy_version": {"const": "stage1-environment-capture/v1"},
    "capture_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reproducibility_grade": {"enum": ["isolated-conda-environment", "container-pinned"]}
  }
}
