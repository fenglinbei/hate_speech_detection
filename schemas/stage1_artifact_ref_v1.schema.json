{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stage1/schemas/stage1_artifact_ref_v1.schema.json",
  "title": "Stage 1 artifact locator or dependency reference",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "artifact_id", "target_path", "payload_manifest_sha256"],
      "properties": {
        "schema_version": {"const": "stage1-locator-ref/v1"},
        "artifact_kind": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "target_path": {"type": "string", "pattern": "^/"},
        "payload_manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "artifact_id", "payload_manifest_sha256", "logical_repo_path"],
      "properties": {
        "schema_version": {"const": "stage1-dependency-ref/v1"},
        "artifact_kind": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "payload_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "logical_repo_path": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
