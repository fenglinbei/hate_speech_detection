{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stage1/schemas/stage1_training_receipt_v1.schema.json",
  "title": "Stage 1 immutable training receipt",
  "type": "object",
  "required": [
    "schema_version",
    "training_plan_dependency",
    "training_evidence_dependency",
    "train_partition_dependency",
    "schedule_dependency",
    "base_model_dependency",
    "environment_dependency",
    "model_key",
    "role",
    "seed",
    "planned_epochs",
    "completed_epochs",
    "completed_epoch_registry",
    "selected_checkpoint_epoch",
    "selected_checkpoint_global_step",
    "training_exit_global_step",
    "global_step",
    "schedule_record_policy",
    "fit_query_ids_sha256",
    "fit_query_count",
    "calibration_query_ids_sha256",
    "calibration_query_count",
    "fixed_presentation",
    "final_checkpoint_rule",
    "checkpoint_selection_audit",
    "train_config_sha256",
    "train_code_sha256",
    "runtime_code_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "stage1-training-receipt/v1"},
    "training_plan_dependency": {"$ref": "#/$defs/dependency"},
    "training_evidence_dependency": {"$ref": "#/$defs/dependency"},
    "train_partition_dependency": {"$ref": "#/$defs/dependency"},
    "schedule_dependency": {"$ref": "#/$defs/dependency"},
    "base_model_dependency": {"$ref": "#/$defs/dependency"},
    "environment_dependency": {"$ref": "#/$defs/dependency"},
    "model_key": {"type": "string", "pattern": "^(M_LD|M_drop)/seed-[1-9][0-9]*$"},
    "role": {"enum": ["M_LD", "M_drop"]},
    "seed": {"type": "integer", "minimum": 0},
    "planned_epochs": {"type": "integer", "minimum": 1},
    "completed_epochs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "completed_epoch_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "epoch",
          "global_step",
          "all_records_sha256",
          "fit_records_sha256",
          "calibration_records_sha256",
          "fit_record_count",
          "calibration_record_count"
        ],
        "properties": {
          "epoch": {"type": "integer", "minimum": 1},
          "global_step": {"type": "integer", "minimum": 1},
          "all_records_sha256": {"$ref": "#/$defs/sha256"},
          "fit_records_sha256": {"$ref": "#/$defs/sha256"},
          "calibration_records_sha256": {"$ref": "#/$defs/sha256"},
          "fit_record_count": {"type": "integer", "minimum": 1},
          "calibration_record_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "selected_checkpoint_epoch": {"type": "integer", "minimum": 1},
    "selected_checkpoint_global_step": {"type": "integer", "minimum": 1},
    "selected_checkpoint_inventory": {"$ref": "#/$defs/checkpoint_tree"},
    "training_exit_global_step": {"type": "integer", "minimum": 1},
    "global_step": {"type": "integer", "minimum": 1},
    "schedule_record_policy": {"const": "completed-epoch-fit-and-calibration-record-hashes/v1"},
    "fit_query_ids_sha256": {"$ref": "#/$defs/sha256"},
    "fit_query_count": {"type": "integer", "minimum": 1},
    "calibration_query_ids_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_query_count": {"type": "integer", "minimum": 1},
    "fixed_presentation": {"$ref": "#/$defs/fixed_presentation"},
    "final_checkpoint_rule": {"const": "best-eval-loss-threshold-earliest/v1"},
    "checkpoint_selection_audit": {"$ref": "#/$defs/checkpoint_selection_audit"},
    "train_config_sha256": {"$ref": "#/$defs/sha256"},
    "train_code_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_code_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_tree_file": {
      "type": "object",
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "^/|(^|/)\\.\\.(/|$)"}},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "checkpoint_tree": {
      "type": "object",
      "required": [
        "schema_version", "inventory_policy", "logical_repo_path",
        "file_count", "total_bytes", "files", "file_tree_sha256"
      ],
      "properties": {
        "schema_version": {"const": "stage1-regular-file-tree/v1"},
        "inventory_policy": {"const": "all-regular-files/v1"},
        "logical_repo_path": {"type": "string", "minLength": 1, "not": {"pattern": "^/|(^|/)\\.\\.(/|$)"}},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkpoint_tree_file"}
        },
        "file_tree_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "artifact_id", "payload_manifest_sha256", "logical_repo_path"],
      "properties": {
        "schema_version": {"const": "stage1-dependency-ref/v1"},
        "artifact_kind": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "payload_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "logical_repo_path": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}}
      },
      "additionalProperties": false
    },
    "early_stopping_policy": {
      "type": "object",
      "required": [
        "enabled", "metric", "mode", "minimum_epochs", "maximum_epochs",
        "patience_evaluations", "threshold", "tie_break", "selection_data",
        "scientific_dev_used_for_selection"
      ],
      "properties": {
        "enabled": {"const": true},
        "metric": {"const": "eval_loss"},
        "mode": {"const": "min"},
        "minimum_epochs": {"type": "integer", "minimum": 1},
        "maximum_epochs": {"type": "integer", "minimum": 1},
        "patience_evaluations": {"type": "integer", "minimum": 1},
        "threshold": {"type": "number", "minimum": 0},
        "tie_break": {"const": "earliest-global-step"},
        "selection_data": {"const": "train-only-calibration"},
        "scientific_dev_used_for_selection": {"const": false}
      },
      "additionalProperties": false
    },
    "fixed_presentation": {
      "type": "object",
      "required": [
        "policy", "wire_epoch", "demo_order_across_epochs",
        "source_mask_across_epochs"
      ],
      "properties": {
        "policy": {"const": "calibration-epoch-1-wire/v1"},
        "wire_epoch": {"const": 1},
        "demo_order_across_epochs": {"const": true},
        "source_mask_across_epochs": {"const": true}
      },
      "additionalProperties": false
    },
    "checkpoint_evaluation": {
      "type": "object",
      "required": [
        "epoch", "global_step", "metric_name", "metric_value",
        "qualifying_improvement", "patience_counter_after",
        "best_global_step_after"
      ],
      "properties": {
        "epoch": {"type": "integer", "minimum": 1},
        "global_step": {"type": "integer", "minimum": 1},
        "metric_name": {"const": "eval_loss"},
        "metric_value": {"type": "number"},
        "qualifying_improvement": {"type": "boolean"},
        "patience_counter_after": {"type": "integer", "minimum": 0},
        "best_global_step_after": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "checkpoint_selection_audit": {
      "type": "object",
      "required": [
        "schema_version", "policy", "evaluation_history",
        "evaluation_history_sha256", "selected_metric_value",
        "selected_global_step", "stop_reason"
      ],
      "properties": {
        "schema_version": {"const": "stage1-checkpoint-selection-audit/v1"},
        "policy": {"$ref": "#/$defs/early_stopping_policy"},
        "evaluation_history": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkpoint_evaluation"}
        },
        "evaluation_history_sha256": {"$ref": "#/$defs/sha256"},
        "selected_metric_value": {"type": "number"},
        "selected_global_step": {"type": "integer", "minimum": 1},
        "stop_reason": {"enum": ["early-stopping-patience", "maximum-epochs"]}
      },
      "additionalProperties": false
    }
  }
}
