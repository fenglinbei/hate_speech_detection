{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_p0_validation_report_v1.schema.json",
  "title": "Stage 1 P0 blocking validation and readiness report",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "status",
    "ready",
    "status_precedence",
    "decision_register",
    "sealed_test",
    "summary",
    "checks",
    "gaps",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "stage1-p0-validation-report/v1"},
    "mode": {"enum": ["engineering-smoke", "formal-readiness"]},
    "status": {"$ref": "#/$defs/status"},
    "ready": {"type": "boolean"},
    "status_precedence": {
      "type": "array",
      "prefixItems": [
        {"const": "FAIL"},
        {"const": "BLOCKED"},
        {"const": "PENDING"},
        {"const": "PASS"}
      ],
      "items": false
    },
    "decision_register": {
      "type": "object",
      "required": ["logical_path", "sha256", "frozen"],
      "properties": {
        "logical_path": {"const": "config/stage1/decision_register.json"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "frozen": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sealed_test": {
      "type": "object",
      "required": ["execution_performed", "target_content_read", "policy", "discovered_ref_names"],
      "properties": {
        "execution_performed": {"const": false},
        "target_content_read": {"const": false},
        "policy": {"const": "synthetic-only-not-executed"},
        "discovered_ref_names": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(test[/_A-Za-z0-9.-]*)$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["PASS", "BLOCKED", "PENDING", "FAIL"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0},
        "PENDING": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"}
    },
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "status": {"enum": ["PASS", "BLOCKED", "PENDING", "FAIL"]},
    "artifact": {
      "type": "object",
      "required": ["artifact_kind", "artifact_id", "payload_manifest_sha256", "logical_target_path"],
      "properties": {
        "artifact_kind": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
        "payload_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "logical_target_path": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["check_id", "area", "phase", "status", "reason_code", "ref_path", "artifact", "metrics"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "area": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "phase": {"enum": ["p0-prerequisite", "engineering-smoke", "post-training-formal", "sealed-boundary"]},
        "status": {"$ref": "#/$defs/status"},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "ref_path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "not": {"pattern": "^/"}}
          ]
        },
        "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "metrics": {"type": "object"}
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["check_id", "area", "phase", "status", "reason_code", "ref_path"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "area": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "phase": {"enum": ["p0-prerequisite", "engineering-smoke", "post-training-formal", "sealed-boundary"]},
        "status": {"enum": ["BLOCKED", "PENDING", "FAIL"]},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "ref_path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "not": {"pattern": "^/"}}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
