{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/wp3_g3_form_reference_v1.schema.json",
  "title": "WP3 G3 human-frozen form reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_role", "scope", "scientific_eligible", "sealed", "rows"],
  "properties": {
    "schema_version": {"const": "wp3-g3-form-reference/v1"},
    "reference_role": {"const": "form-only-label-free-non-lexicon"},
    "scope": {"const": "development-only"},
    "scientific_eligible": {"const": false},
    "sealed": {"const": false},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "trimmed": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "pinyin", "initials", "phonetic_scan_enabled", "variants"],
      "properties": {
        "canonical": {"$ref": "#/$defs/trimmed"},
        "pinyin": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]+$"}},
        "initials": {"type": ["string", "null"], "pattern": "^[a-z]+$"},
        "phonetic_scan_enabled": {"type": "boolean"},
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "family", "evidence_ids"],
            "properties": {
              "surface": {"$ref": "#/$defs/trimmed"},
              "family": {"enum": ["known_variant", "phonetic_variant", "orthographic_variant"]},
              "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^g3ev-[a-z0-9-]+$"}}
            }
          }
        }
      }
    }
  }
}
