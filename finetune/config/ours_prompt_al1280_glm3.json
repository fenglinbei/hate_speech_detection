        "transformer.encoder.layers.4": "cuda:1",
        "transformer.encoder.layers.5": "cuda:1",
        "transformer.encoder.layers.6": "cuda:1",
        "transformer.encoder.layers.7": "cuda:1",
        "transformer.encoder.layers.8": "cuda:1",
        "transformer.encoder.layers.9": "cuda:1",

        "transformer.encoder.layers.10": "cuda:2",
        "transformer.encoder.layers.11": "cuda:2",
        "transformer.encoder.layers.12": "cuda:2",
        "transformer.encoder.layers.13": "cuda:2",
        "transformer.encoder.layers.14": "cuda:2",
        "transformer.encoder.layers.15": "cuda:2",
        "transformer.encoder.layers.16": "cuda:2",
