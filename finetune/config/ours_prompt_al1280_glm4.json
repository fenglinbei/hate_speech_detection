{
    "model_name": "ZhipuAI/glm-4-9b-chat",
    "model_path": "./models/glm-4-9b-chat",
    "prompt_template": "RAG_PROMPT_USER_V2",
    "system_prompt": "",
    "max_length": 1280,
    "lora": false,
    "random_seed": 23333333,
    "exp_name": "glm-4-9b-chat-ours-prompt-al1280",
    "project_name": "glm-4-9b-chat",
    
    "device_map": "auto",
    
    "data": {
        "train_data_path": "finetune/data/ours_prompt_al1280_glm4/train.jsonl",
        "val_data_path": "finetune/data/ours_prompt_al1280_glm4/val.jsonl"
    },
    
    "training": {
        "output_dir": "models/glm-4-9b-chat-ours-prompt-al1280",
        "per_device_train_batch_size": 2,
        "per_device_eval_batch_size": 2,
        "gradient_accumulation_steps": 4,
        "eval_strategy": "steps",
        "eval_steps": 100,
        "logging_steps": 10,
        "num_train_epochs": 2,
        "save_strategy": "epoch",
        "learning_rate": 1e-5,
        "save_on_each_node": true,
        "gradient_checkpointing": true,
        "report_to": "none",
        "run_name": "glm-4-9b-chat-ours-prompt-al1280",
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0,
        "bf16": true
    },
    
    "eval": {
        "max_retries": 0,
        "eval_num": 100,
        "max_length": 1280
    },
    
    "cuda_devices": [0, 1, 2, 3]
}