{
  "project": "hatexplain",
  "output_root": "exps/hatexplain/baselines",
  "base": {
    "build": "exps/hatexplain/base_config/data_config.json",
    "train": "exps/hatexplain/base_config/train_config.json",
    "runner": "exps/hatexplain/base_config/eval_config.json"
  },
  "port_base": 35100,
  "train_cuda_visible_devices": "0,1,2,3",
  "vllm": {
    "cuda_visible_devices": "0,1,2,3",
    "tensor_parallel_size": 4,
    "max_model_len": 8192,
    "served_model_name": "qwen2.5"
  },
  "reuse": {
    "data_dir": null,
    "model_checkpoint": null
  },
  "grid": [
    {
      "name": "srag",
      "build.retrieval_settings.srag_top_k": 1,
      "build.retrieval_settings.use_lex": false,
      "build.prompt_templates.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "train.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "runner.tester.prompt_templates.train": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX"
    },
    {
      "name": "zero_shot",
      "build.retrieval_settings.srag_top_k": 0,
      "build.retrieval_settings.use_lex": false,
      "build.prompt_templates.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "train.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "runner.tester.prompt_templates.train": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX"
    },
    {
      "name": "ids",
      "runner.baseline.method": "ids",
      "runner.baseline.task_type": "hatexplain",
      "runner.tester.run.llm_params.enable_thinking": false,
      "runner.tester.run.llm_params.max_new_tokens": 1024,
      "build.retrieval_settings.use_lex": false,
      "build.prompt_templates.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "train.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "runner.tester.prompt_templates.train": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX"
    },
    {
      "name": "dpp",
      "runner.baseline.method": "dpp",
      "runner.baseline.task_type": "hatexplain",
      "runner.tester.run.llm_params.enable_thinking": false,
      "build.retrieval_settings.use_lex": false,
      "build.prompt_templates.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "train.prompt_template": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX",
      "runner.tester.prompt_templates.train": "HATEXPLAIN_RAG_PROMPT_USER_WO_LEX"
    },
    {
      "name": "explicit_cot",
      "runner.baseline.method": "explicit_cot",
      "runner.baseline.task_type": "hatexplain",
      "build.prompt_templates.prompt_template": "HATEXPLAIN_EXPLICIT_COT_RAG_PROMPT_USER",
      "train.prompt_template": "HATEXPLAIN_EXPLICIT_COT_RAG_PROMPT_USER",
      "runner.tester.prompt_templates.train": "HATEXPLAIN_EXPLICIT_COT_RAG_PROMPT_USER",
      "runner.tester.run.llm_params.enable_thinking": false,
      "runner.tester.run.llm_params.max_new_tokens": 1024,
      "build.retrieval_settings.use_lex": false
    }
  ]
}
