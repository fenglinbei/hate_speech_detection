{
  "project": "cold_binary_baselines",
  "output_root": "exps/cold/baselines",
  "base": {
    "build": "exps/cold/base_config_binary/data_config.json",
    "train": "exps/cold/base_config_binary/train_config.json",
    "runner": "exps/cold/base_config_binary/eval_config.json"
  },
  "port_base": 35400,
  "train_cuda_visible_devices": "0,1,2,3",
  "vllm": {
    "cuda_visible_devices": "0,1,2,3",
    "tensor_parallel_size": 4,
    "max_model_len": 8192,
    "served_model_name": "qwen2.5"
  },
  "reuse": {
    "data_dir": null,
    "model_checkpoint": null
  },
  "grid": [
    {
      "name": "ids",
      "runner.baseline.method": "ids",
      "runner.baseline.task_type": "cold_binary",
      "runner.tester.run.llm_params.enable_thinking": false,
      "runner.tester.run.llm_params.max_new_tokens": 512
    },
    {
      "name": "dpp",
      "runner.baseline.method": "dpp",
      "runner.baseline.task_type": "cold_binary",
      "runner.tester.run.llm_params.enable_thinking": false
    },
    {
      "name": "explicit_cot",
      "runner.baseline.method": "explicit_cot",
      "runner.baseline.task_type": "cold_binary",
      "build.prompt_templates.prompt_template": "COLD_BINARY_EXPLICIT_COT_RAG_PROMPT_USER",
      "train.prompt_template": "COLD_BINARY_EXPLICIT_COT_RAG_PROMPT_USER",
      "runner.tester.prompt_templates.train": "COLD_BINARY_EXPLICIT_COT_RAG_PROMPT_USER",
      "runner.tester.run.llm_params.enable_thinking": false,
      "runner.tester.run.llm_params.max_new_tokens": 512
    }
  ]
}

