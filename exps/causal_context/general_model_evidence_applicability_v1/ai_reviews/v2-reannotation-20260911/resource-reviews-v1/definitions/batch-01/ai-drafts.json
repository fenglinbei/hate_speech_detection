    {
      "object_id": "definition:lex-0343:sense:01",
      "kind": "definition",
      "source_sha256": "28410f194e3db7b34eee1c509c4da8698d50c3f900f2834cca2a2c205249fc02",
      "definition_text_sha256": "44317ccbe35340a22435537ab6756acb4d18e6f310d165b7df252839a359d593",
      "base_version": 0,
      "values": {
        "definition_verdict": "",
        "issues": [],
        "evidence": [
          {
            "source": "text",
            "start": 0,
            "end": 23,
            "text": "同性恋者隐瞒自己性取向，步入异性恋婚姻的行为。"
          }
        ],
        "note": "把骗婚仅定义为同性恋隐瞒性取向进入异性婚姻，可能将较广的欺骗婚姻行为过窄绑定LGBTQ；单列特殊义还是扩展需校准。"
      },
      "proposal": {
        "definition_verdict": "too_narrow",
        "issues": [
          "overly_narrow_definition"
        ],
        "suggested_definition": "以欺骗手段使他人进入婚姻，或利用婚姻关系实施欺骗；在部分性取向讨论中，可特指隐瞒性取向与异性结婚，不应将该情形等同所有骗婚或所有同性恋者。"
      },
      "assessment_status": "needs_discussion",
      "review_kind": "ai_note",
      "rule_ids": [
        "P08",
        "P09"
      ],
      "new_human_fields": [],
      "online_material_confirmed": false
    },
    {
      "object_id": "definition:lex-0437:sense:01",
      "kind": "definition",
      "source_sha256": "e86bc8de81432f7d25e377f36b500f7da5eeafa9c54a653538a4c974b966d514",
      "definition_text_sha256": "24e6fd44928239098f8a44ef5c0e54b1293a05b1fbed394daa640047d48835dd",
      "base_version": 0,
      "values": {
        "definition_verdict": "other_problem",
        "issues": [
          "wrong_sense"
        ],
        "evidence": [
          {
            "source": "text",
            "start": 0,
            "end": 74,
            "text": "意思是那些无原则底线的包容、原谅他人，对任何人事物都抱有博爱之心，不讲求客观事实，一切行动准则都只围绕“爱”“善”两字为中心，会因此伤害到他人的人。"
          }
        ],
        "note": "将无原则、不讲事实及伤害他人写成被称呼者属性；应明确这是一种讽刺性指控。"
      },
      "proposal": {
        "definition_verdict": "other_problem",
        "issues": [
          "wrong_sense"
        ],
        "suggested_definition": "网络争论中对被认为无原则地宽容、原谅或倡导善意者的讽刺性称呼；这些是使用者的评价，不是由称呼即可证明的事实。宗教等用法另辨。"
      },
      "assessment_status": "ai_reviewed",
      "review_kind": "ai_note",
      "rule_ids": [
        "P05",
        "P19"
      ],
      "new_human_fields": [],
      "online_material_confirmed": false
    },
    {
