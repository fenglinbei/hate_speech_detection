    {
      "object_id": "definition:lex-0463:sense:01",
      "kind": "definition",
      "source_sha256": "c75863de3084ddb59faff4b0a11d5414f8a390f82f80ba8634c141051179f0bc",
      "definition_text_sha256": "b5b2de045f493093ce0bcd0e392aba2ed33195a223bac6971209daa3bbcebe8e",
      "base_version": 0,
      "values": {
        "definition_verdict": "",
        "issues": [],
        "evidence": [
          {
            "source": "text",
            "start": 0,
            "end": 35,
            "text": "一般**是通配符号，可以替代所有的字符，常用于替换一些敏感或毒性用词。"
          }
        ],
        "note": "**的作用依约定与语境，可遮蔽、暗示、排版或作字面符号；不能普遍解释成替代所有字符或已被平台屏蔽。"
      },
      "proposal": {
        "definition_verdict": "other_problem",
        "issues": [
          "wrong_sense"
        ],
        "suggested_definition": "在部分文本中可隐去或暗示未写出的词语，包括粗俗或敏感内容；也可能是排版、技术或字面符号。不能单凭星号还原具体辱词或认定经过平台屏蔽。"
      },
