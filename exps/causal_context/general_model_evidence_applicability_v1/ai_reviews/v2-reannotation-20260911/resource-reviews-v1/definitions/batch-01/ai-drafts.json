    {
      "object_id": "definition:lex-0473:sense:01",
      "kind": "definition",
      "source_sha256": "fa2cfa5b97fefaeacc62fef41e5762a462db10518289c6b3371af74a3642e73f",
      "definition_text_sha256": "4fb1ef83acf950cf4050a7d3f6a420b45efe7fe2fb3526fb37a24640fae95289",
      "base_version": 0,
      "values": {
        "definition_verdict": "",
        "issues": [],
        "evidence": [
          {
            "source": "text",
            "start": 0,
            "end": 76,
            "text": "网络用语主要指的是中国城市上海。这一隐喻起源于2022年上海第六人民医院发布的一篇关于救治外籍患者特殊病例的文章，引发了公众对于医疗资源分配问题的讨论。"
          }
        ],
        "note": "作为上海戏称有已审句内用法线索，但原释义的确定词源和历史细节目前主要为二手资料；可将核心语用与词源可信度分开。"
      },
      "proposal": {
        "definition_verdict": "uncertain",
        "issues": [
          "uncertain"
        ],
        "suggested_definition": "在部分中文网络语境中用作上海的戏称或贬称；应与苏格兰城市爱丁堡的正常地名用法区分。具体起源叙述另作来源核验。"
      },
      "assessment_status": "needs_discussion",
      "review_kind": "ai_note",
      "rule_ids": [
        "P06",
        "P11",
        "P19"
      ],
      "new_human_fields": [],
      "online_material_confirmed": false
    },
    {
      "object_id": "definition:lex-0562:sense:01",
      "kind": "definition",
      "source_sha256": "1683aebbbac4804a33ba5eb26044dbdb5a9bf837f6bc9ea933a0f5d56bee19a5",
      "definition_text_sha256": "02a32d9295b541307d73f478ad3bdace42f8233431bf8b6e7679be654974541d",
      "base_version": 0,
      "values": {
        "definition_verdict": "",
        "issues": [],
        "evidence": [
          {
            "source": "text",
            "start": 0,
            "end": 87,
            "text": "网络用语，指那些行为举止异常、情绪不稳定的现象，通常表现为对某些事物极度热爱，甚至产生戒断反应，失去这些事物后无法自拔。这种现象在网络上尤为常见，常常出现在社交网络骂战中。‌"
          }
        ],
        "note": "定义将魔怔过多绑定热爱、戒断与无法自拔，且容易写成精神状态诊断。可改为对言行偏执、极端或失常的评价性说法。"
      },
      "proposal": {
        "definition_verdict": "other_problem",
        "issues": [],
        "suggested_definition": "用来形容或讥讽被认为言行偏执、极端、反常或过度沉迷的人及其状态；这是说话者的评价，不等同医学诊断，也不必然涉及戒断反应。"
      },
      "assessment_status": "needs_discussion",
      "review_kind": "ai_note",
      "rule_ids": [
        "P05",
        "P11"
      ],
      "new_human_fields": [],
      "online_material_confirmed": false
    },
