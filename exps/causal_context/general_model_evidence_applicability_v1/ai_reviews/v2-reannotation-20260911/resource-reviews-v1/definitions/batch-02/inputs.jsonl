{"id": "definition:lex-0005:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0005", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0005:sense:01", "term": "黑哥", "text": "对黑人群体的侮辱性用词。"}}
{"id": "definition:lex-0016:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0016", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0016:sense:01", "term": "杀默", "text": "'默'是'黑犬'的拼字，指黑色的狗，对黑人群体的迫害行为。"}}
{"id": "definition:lex-0018:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0018", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0018:sense:01", "term": "墨", "text": "'墨'代指'黑色'，常用于代指黑人群体，含贬义。"}}
{"id": "definition:lex-0021:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0021", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0021:sense:01", "term": "白完", "text": "'白完'是'皖'的拼字，指安徽省，含贬义。"}}
{"id": "definition:lex-0029:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0029", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0029:sense:01", "term": "井盖", "text": "常与'河南人一起使用'，暗示河南人素质低、道德水平差。"}}
{"id": "definition:lex-0048:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0048", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0048:sense:01", "term": "傻*", "text": "'傻*'是'傻逼'的和谐版，属于脏话、俗语、中国俚语、粗俗用语与忌语、恶意的辱骂，在公共场合使用会被视作非常不礼貌的行为。"}}
{"id": "definition:lex-0080:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0080", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0080:sense:01", "term": "公交车", "text": "在部分性别贬损语境中，以可供多人乘坐的交通工具比喻女性与多人发生过性关系，对其污名化；这些是说话者的贬损指控，不是对女性行为或品格的事实认定。"}}
{"id": "definition:lex-0080:sense:02", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0080", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0080:sense:02", "term": "公交车", "text": "也存在不限定女性对象的类似性关系污名化用法；应结合所指对象判断，普通交通工具含义不属于贬损义。"}}
{"id": "definition:lex-0082:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0082", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0082:sense:01", "term": "崇洋媚外", "text": "指责某人盲目推崇外国事物、奉承外国人，常带贬义；这是说话者的评价，不是从词面即可证实的事实。"}}
{"id": "definition:lex-0092:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0092", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0092:sense:01", "term": "女拳王", "text": "常用于对中国女权主义者的贬义表达。"}}
{"id": "definition:lex-0105:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0105", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0105:sense:01", "term": "烂裤裆", "text": "对一些私生活不检点甚至糜烂的女人的侮辱性表达。"}}
{"id": "definition:lex-0119:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0119", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0119:sense:01", "term": "过男", "text": "'过男'是'国男'的中文谐音，指中国女权主义者攻击男性的一种称谓。"}}
{"id": "definition:lex-0174:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0174", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0174:sense:01", "term": "棒畜", "text": "'棒子'的衍生词，对韩国人的侮辱性用词。"}}
{"id": "definition:lex-0175:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0175", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0175:sense:01", "term": "炼铜", "text": "'炼铜'是'恋童'的中文谐音，指16岁以上的青少年或者成年人认为13岁以下的儿童拥有主要的性吸引力，或者认为只有其才有性吸引力的一种现象。"}}
{"id": "definition:lex-0191:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0191", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0191:sense:01", "term": "nt", "text": "'nt'是'脑瘫'的中文拼音首字母缩写，用于讽刺有关人物智力低下，反应迟钝，或者存在神经功能障碍。"}}
{"id": "definition:lex-0212:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0212", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0212:sense:01", "term": "江浙人种", "text": "由于江苏浙江为经济发达地区，部分江浙人对经济欠发达地区存在地域歧视，'江浙人种'为其余地区对这部分人的讽刺性称呼。"}}
{"id": "definition:lex-0236:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0236", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0236:sense:01", "term": "普信女", "text": "普通却自信的女人简称，常含贬义。"}}
{"id": "definition:lex-0247:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0247", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0247:sense:01", "term": "婊子", "text": "对女性群体的侮辱性称呼。"}}
{"id": "definition:lex-0256:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0256", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0256:sense:01", "term": "爬", "text": "在部分川渝方言及网络口语中表示语气强烈的“走开”或“滚”；普通爬行动作不属于这一驱赶义。"}}
{"id": "definition:lex-0267:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0267", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0267:sense:01", "term": "虫", "text": "在部分明确指人的上下文中，可借虫类比喻贬损对象；普通虫类名称以及更长的完整词“寄生虫”中的单字不应重复或一律解释为针对黑人。"}}
{"id": "definition:lex-0282:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0282", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0282:sense:01", "term": "母畜", "text": "指雌性畜生，对女性群体的侮辱性称呼。"}}
{"id": "definition:lex-0287:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0287", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0287:sense:01", "term": "黑蛆", "text": "对黑人群体的侮辱性用词。"}}
{"id": "definition:lex-0290:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0290", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0290:sense:01", "term": "小黑", "text": "对黑人群体的侮辱性用词。"}}
{"id": "definition:lex-0292:sense:01", "kind": "definition", "source": {"categories": ["LGBTQ", "others"], "entry_id": "lex-0292", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0292:sense:01", "term": "真“艾”", "text": "'真“艾”'是'真爱'的中文谐音，常用于对同性恋群体或艾滋病群体的贬义表达。"}}
{"id": "definition:lex-0325:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0325", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0325:sense:01", "term": "孝子", "text": "本意为孝顺父母的儿子或儿女，后网络中用于形容那些盲目崇拜某种群体、制度或价值观等的人，含贬义。"}}
{"id": "definition:lex-0333:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0333", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0333:sense:01", "term": "理中客", "text": "被用来讽刺那些不明白前因后果，对事件一知半解，站在道德制高点评判别人的人。，含贬义。"}}
{"id": "definition:lex-0334:sense:01", "kind": "definition", "source": {"categories": ["Region", "Racism"], "entry_id": "lex-0334", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0334:sense:01", "term": "洋垃圾", "text": "对外国人群体的侮辱性用词。"}}
{"id": "definition:lex-0338:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0338", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0338:sense:01", "term": "打黑", "text": "双关词，常用于打击黑社会势力，也被用于对黑人群体的迫害行为。"}}
{"id": "definition:lex-0340:sense:01", "kind": "definition", "source": {"categories": ["Region", "Racism"], "entry_id": "lex-0340", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0340:sense:01", "term": "三非", "text": "指那些未经合法手续而在中国非法就业、非法入境和非法居留的所有外国人的统称。"}}
{"id": "definition:lex-0378:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0378", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0378:sense:01", "term": "YP", "text": "在部分与“性”或者相关的网络语境上下文中可为“约炮”的首字母缩写，表示非固定伴侣之间约定性接触。缩写可有不同展开，词面和 ASCII 大小写规范化本身不能确定具体义项。"}}
{"id": "definition:lex-0378:sense:02", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0378", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0378:sense:02", "term": "YP", "text": "在部分地域歧视或种族歧视相关的网络语境上下文中可为“硬盘”的首字母缩写，用于贬称“外地人”或者“外来人员”，其来源为外地人-WDR-WD-硬盘-YP。缩写可有不同展开，词面和 ASCII 大小写规范化本身不能确定具体义项。"}}
{"id": "definition:lex-0380:sense:01", "kind": "definition", "source": {"categories": ["Racism", "Sexism"], "entry_id": "lex-0380", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0380:sense:01", "term": "白楠", "text": "'白楠'是'白男'中文谐音，常用于对白种人男性的讽刺性称呼。"}}
{"id": "definition:lex-0381:sense:01", "kind": "definition", "source": {"categories": ["Racism", "Sexism"], "entry_id": "lex-0381", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0381:sense:01", "term": "白男", "text": "常用于对白种人男性的讽刺性称呼。"}}
{"id": "definition:lex-0382:sense:01", "kind": "definition", "source": {"categories": ["Racism", "Sexism"], "entry_id": "lex-0382", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0382:sense:01", "term": "白女", "text": "常用于对白种人女性的讽刺性称呼。"}}
{"id": "definition:lex-0383:sense:01", "kind": "definition", "source": {"categories": ["Racism", "Sexism"], "entry_id": "lex-0383", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0383:sense:01", "term": "黑男", "text": "常用于对黑种人男性的讽刺性称呼。"}}
{"id": "definition:lex-0411:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0411", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0411:sense:01", "term": "黑黑", "text": "对黑人群体的侮辱性称呼。"}}
{"id": "definition:lex-0427:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0427", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0427:sense:01", "term": "嘿玩意", "text": "'嘿玩意'是'黑玩意'的中文谐音，对黑人群体的侮辱性称呼。"}}
{"id": "definition:lex-0438:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0438", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0438:sense:01", "term": "老g", "text": "通常指的是'老家伙'或'老古董'，用于形容某人或某事物过时或老旧，常用于调侃或讽刺。"}}
{"id": "definition:lex-0441:sense:01", "kind": "definition", "source": {"categories": ["LGBTQ"], "entry_id": "lex-0441", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0441:sense:01", "term": "人妖", "text": "泛指心理性别错位、男扮女装等非常态之人，含贬义。"}}
{"id": "definition:lex-0453:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0453", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0453:sense:01", "term": "h人", "text": "'h人'指'黑人'首字母缩写加汉字，常用于对黑人群体的称呼，含贬义。"}}
{"id": "definition:lex-0454:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0454", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0454:sense:01", "term": "接盘", "text": "形容男人愿意接受女人复杂的情史、堕胎等行为，并愿意娶她为妻。"}}
{"id": "definition:lex-0468:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0468", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0468:sense:01", "term": "二鬼子", "text": "抗日战争时期人民群众对汉奸伪军的蔑称，网络中也常用于对汉奸或媚外群体的贬义称呼。"}}
{"id": "definition:lex-0484:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0484", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0484:sense:01", "term": "cjb", "text": "网络用语，多含讽刺意，多用于表达名不副实的意思。"}}
{"id": "definition:lex-0486:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0486", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0486:sense:01", "term": "fw", "text": "'fw'发音为'废物'拼音缩写，比喻没有用或妨碍自己的人（指责人的话）。"}}
{"id": "definition:lex-0493:sense:01", "kind": "definition", "source": {"categories": ["Sexism", "others"], "entry_id": "lex-0493", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0493:sense:01", "term": "剑人", "text": "'剑人'是'贱人'的中文谐音，指卑贱的人，多用于辱骂妇女。"}}
{"id": "definition:lex-0494:sense:01", "kind": "definition", "source": {"categories": ["Region", "Racism"], "entry_id": "lex-0494", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0494:sense:01", "term": "学伴", "text": "本意为学习的同伴。后因山东大学为该校留学生配对学伴引起广泛争议，常用于媚外场景。"}}
{"id": "definition:lex-0506:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0506", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0506:sense:01", "term": "50w", "text": "'50w'指'50万'，网络用语，主要指潜伏在中国的间谍，根据《公民举报间谍线索行动奖励办法》，如果举报间谍有功奖励10万至50万奖金。"}}
{"id": "definition:lex-0525:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0525", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0525:sense:01", "term": "凯乐奇计划", "text": "一个未经验证的种族计划，目的是瓦解各个国家的主体民族、创造混血儿、抹杀主体民族的记忆和历史，最终创造出一个没有国界，没有种族，没有道德感，没有历史，没有文化的新人种。"}}
{"id": "definition:lex-0527:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-0527", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0527:sense:01", "term": "凯勒奇计划", "text": "一个未经验证的种族计划，目的是瓦解各个国家的主体民族、创造混血儿、抹杀主体民族的记忆和历史，最终创造出一个没有国界，没有种族，没有道德感，没有历史，没有文化的新人种。"}}
{"id": "definition:lex-0597:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0597", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0597:sense:01", "term": "京巴", "text": "小型犬类的一种，对北京人的侮辱性称呼。"}}
{"id": "definition:lex-0603:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0603", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0603:sense:01", "term": "美国佬", "text": "对美国人的调侃性称呼。"}}
{"id": "definition:lex-0621:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0621", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0621:sense:01", "term": "陕蛋蛋", "text": "对陕西人的侮辱性称呼。"}}
{"id": "definition:lex-0622:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0622", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0622:sense:01", "term": "胡建", "text": "'胡建'是'福建'的中文谐音，常用于指代福建，含贬义。"}}
{"id": "definition:lex-0623:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0623", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0623:sense:01", "term": "东百", "text": "'东百'是'东北'的中文谐音，常用于指代东北地区，含贬义。"}}
{"id": "definition:lex-0625:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0625", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0625:sense:01", "term": "山越猴", "text": "对浙江人的侮辱性称呼。"}}
{"id": "definition:lex-0632:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0632", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0632:sense:01", "term": "神经病", "text": "常用来指某个人脑子不正常。"}}
{"id": "definition:lex-0663:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0663", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0663:sense:01", "term": "tm", "text": "在网络语境下，“tm”常作为“他妈”的谐音替代，用于表达愤怒或调侃，属于低俗用语。"}}
{"id": "definition:lex-0669:sense:01", "kind": "definition", "source": {"categories": ["Sexism"], "entry_id": "lex-0669", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0669:sense:01", "term": "批", "text": "在部分方言或粗俗表达中可作女性生殖器的俗称；“批评”“批判”以及普通批次或程度构式中的“批”不能直接套用这一义项。"}}
{"id": "definition:lex-0673:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0673", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0673:sense:01", "term": "蛆", "text": "常用的脏话俗语。"}}
{"id": "definition:lex-0679:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0679", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0679:sense:01", "term": "嘴炮", "text": "网络流行语，指通过言语攻击或说服他人，但缺乏实际行动的行为或人，常用于ACGN文化或日常调侃中。"}}
{"id": "definition:lex-0743:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0743", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0743:sense:01", "term": "渣滓", "text": "可喻指社会中的败类或无用之人。"}}
{"id": "definition:lex-0744:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0744", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0744:sense:01", "term": "杂毛", "text": "本意是指头发蓬乱，现用作骂人的话。"}}
{"id": "definition:lex-0749:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0749", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0749:sense:01", "term": "狗东西", "text": "骂人的话。"}}
{"id": "definition:lex-0758:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-0758", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0758:sense:01", "term": "qj", "text": "'强奸'的拼音缩写，一种违背被害人的意愿，使用暴力、威胁或其他手段强行与被害人进行性交的强制性行为。"}}
{"id": "definition:lex-0790:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0790", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0790:sense:01", "term": "帝都", "text": "由于北京作为中国多个朝代的首都，对北京的调侃性称呼。"}}
{"id": "definition:lex-0791:sense:01", "kind": "definition", "source": {"categories": ["Region"], "entry_id": "lex-0791", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-0791:sense:01", "term": "魔都", "text": "出自曾旅居上海的日本作家村松梢风出版小说《魔都》，对上海的调侃性称呼。"}}
{"id": "definition:lex-new-4db860d45ffeff75:sense:01", "kind": "definition", "source": {"categories": ["LGBTQ"], "entry_id": "lex-new-4db860d45ffeff75", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-new-4db860d45ffeff75:sense:01", "term": "腐女", "text": "通常指对描写男性之间恋爱关系的作品或相关文化感兴趣的女性群体。该称呼可用于自我认同或一般指称，也可能在具体争论中被贬损使用；不能自动等同于极端或不理性。"}}
{"id": "definition:lex-new-85a9a8e7d39af4a3:sense:01", "kind": "definition", "source": {"categories": ["others"], "entry_id": "lex-new-85a9a8e7d39af4a3", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-new-85a9a8e7d39af4a3:sense:01", "term": "舔", "text": "在部分网络口语中，比喻刻意迎合、讨好他人，往往带讽刺或贬义；普通舌头舔舐动作不属于这一比喻义，也不能仅凭此词断定被指称者的动机。"}}
{"id": "definition:lex-new-b5bb7feeffb85985:sense:01", "kind": "definition", "source": {"categories": ["Racism"], "entry_id": "lex-new-b5bb7feeffb85985", "lexicon_sha256": "31240193eeba29f712560e2e80e89ee9dd5c3c969aa180d10b95bf2451882385", "sense_id": "lex-new-b5bb7feeffb85985:sense:01", "term": "黑人喃", "text": ""}}
