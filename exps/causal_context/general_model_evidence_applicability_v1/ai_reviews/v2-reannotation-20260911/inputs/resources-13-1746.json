{
  "definitions": {
    "lex-0069:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国女",
      "text": "“中国女性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；具体语气取决于上下文，不预设使用者一定是男性。"
    },
    "lex-0119:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "过男",
      "text": "'过男'是'国男'的中文谐音，指中国女权主义者攻击男性的一种称谓。"
    },
    "lex-0129:sense:01": {
      "categories": [
        "Sexism",
        "others"
      ],
      "term": "舔狗",
      "text": "指毫无尊严去跪舔他人的人，多指男性。"
    },
    "lex-0453:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "h人",
      "text": "'h人'指'黑人'首字母缩写加汉字，常用于对黑人群体的称呼，含贬义。"
    },
    "lex-0532:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "吊",
      "text": "'吊'与'屌'发音相近，男性生殖器的俗称。"
    },
    "lex-new-85a9a8e7d39af4a3:sense:01": {
      "categories": [
        "others"
      ],
      "term": "舔",
      "text": "在部分网络口语中，比喻刻意迎合、讨好他人，往往带讽刺或贬义；普通舌头舔舐动作不属于这一比喻义，也不能仅凭此词断定被指称者的动机。"
    }
  },
  "demos": {
    "1653": "偶然看到，就评论一下。都是人类，性取向就是萝卜白菜，各有所爱，没有什么高低贵贱。只是想到男男，生理上超级排斥，也就是感觉恶心",
    "1859": "那要知道这些女人男人塑造的，不过是男人怕其他男人变成舔狗罢了",
    "2445": "不好意思，你们的言论我看不懂，因为我从来没有靠过男人（除了我爸爸），也没有诋毁过任何一个正常男性 你们说的那些人跟我也不是一个圈子的，我也无法理解，所以，我也只是从我的角度说出我的想法，意见不一样很正常，我也接受任何的批评",
    "2840": "这个事情就是信誉受损问题，男的也知道不是全部女生都会找黑人，但是信誉受损以后 修复时间很长。",
    "2994": "我的意思是为什么大家不骂黑人，不骂那些为了钱去找黑人的女的，而是要骂所以女的？难不成天底下下所有人都喜欢黑人？在座的各位的妈妈也喜欢黑人？哈哈哈，搞笑",
    "6148": "完全不一样，失足妇女是收费的。为了生活，虽然你不会娶，但是不至于看不起。和黑人搞过，是让人恐惧的，黑人艾滋病几率不用我说吧",
    "6644": "为啥？就是因为现在中国女人地位高到离谱，男人任劳任怨还被女性瞧不起。破坏人类的根本原则",
    "7880": "没有女人缘的吊丝羡慕嫉妒恨了，乱喷有什么用",
    "7927": "你个loser，自己生活失败，就天天黑人怎么怎么样，人家惹你了吗",
    "867": "倒贴找黑老丑的我都隔应，不自重自爱，就要被唾弃。"
  },
  "query": "关键是那么丑那么穷的h人，某些人还跪舔倒贴，这就是人的问题了，我们男的又不是sb！",
