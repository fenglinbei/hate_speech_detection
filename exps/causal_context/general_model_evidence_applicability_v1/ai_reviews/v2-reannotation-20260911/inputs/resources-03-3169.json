{
  "definitions": {
    "lex-0031:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "仙女",
      "text": "在某些情况下被用来指代那些自私自利、双标、让人厌恶的女性。"
    },
    "lex-0104:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "鸡",
      "text": "在部分粗俗语境中可借与“妓”的近音贬损女性或指称性工作者；应描述说话者的用法，不能把对女性的道德指控当作事实。“嫁鸡随鸡”等普通表达不套用该义项。"
    },
    "lex-0419:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "嘿嘿",
      "text": "'嘿嘿'是'黑黑'的中文谐音，对黑人群体的侮辱性称呼。"
    },
    "lex-0486:sense:01": {
      "categories": [
        "others"
      ],
      "term": "fw",
      "text": "'fw'发音为'废物'拼音缩写，比喻没有用或妨碍自己的人（指责人的话）。"
    },
    "lex-0493:sense:01": {
      "categories": [
        "Sexism",
        "others"
      ],
      "term": "剑人",
      "text": "'剑人'是'贱人'的中文谐音，指卑贱的人，多用于辱骂妇女。"
    },
    "lex-0663:sense:01": {
      "categories": [
        "others"
      ],
      "term": "tm",
      "text": "在网络语境下，“tm”常作为“他妈”的谐音替代，用于表达愤怒或调侃，属于低俗用语。"
    }
  },
  "demos": {
    "3519": "和女生相关违法问题不是女生问题是TM谁的问题？主语都有问题还发个鸡毛声，发什么声？÷生？你一个男，怎么还性别歧视？管你你是什么玩意儿",
    "3582": "泼妇男，你贴出我拉黑你？你怎么不贴出你持续不断满篇脏话的撒泼言语呢？嗯？那帖子还能正常回吗？嗯？下作的剑人，哈哈哈[表情]",
    "3585": "这种东西都能照做的不知道是没脊椎还是没脑子，不怕一万就怕万一，万一老婆是个仙女....",
    "3602": "😆哈哈哈哈答主为啥不回你呢",
    "3660": "主要是被嘿嘿玩过的，那不是一般的思想，那得多么的。。。",
    "5780": "互联网没记忆，我记一辈子呢。以后反正梗就天天玩着，诶谁提到我就提这个事情",
    "6035": "哈哈雀食，上大人果然都是你这样😄",
    "6493": "哈哈哈，没想到现在妹子都挺聪明，也知道嘿人那些手段了",
    "7611": "能不能回复啊，笑死了，没见过这么嘴硬小胆的fw，是不是待会还要自己精神胜利一把说我不屑于和你说话啊",
    "7640": "哈哈你看看自己说的是什么破玩意，先学学语文吧😆"
  },
  "query": "我想回个嘿嘿嘿嘿。。。感觉好押韵",
