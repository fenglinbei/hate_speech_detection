{
  "definitions": {
    "lex-0008:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "默",
      "text": "'默'是'黑犬'的拼字，指黑色的狗，对黑人群体的侮辱性称呼。"
    },
    "lex-0016:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "杀默",
      "text": "'默'是'黑犬'的拼字，指黑色的狗，对黑人群体的迫害行为。"
    },
    "lex-0112:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "基佬",
      "text": "'基'同粤语中'gay'的发音，对男同性恋群体的侮辱性表达。"
    },
    "lex-0325:sense:01": {
      "categories": [
        "others"
      ],
      "term": "孝子",
      "text": "本意为孝顺父母的儿子或儿女，后网络中用于形容那些盲目崇拜某种群体、制度或价值观等的人，含贬义。"
    },
    "lex-0449:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "阿娜",
      "text": "'阿娜'是游戏《魔兽世界：军团再临》中的游戏角色'鬼母阿娜'的简称，因其性别为女且形象丑陋，常用于对女性群体的侮辱性称呼，尤其是体型较大的女性群体。"
    },
    "lex-0562:sense:01": {
      "categories": [
        "others"
      ],
      "term": "魔怔",
      "text": "网络用语，指那些行为举止异常、情绪不稳定的现象，通常表现为对某些事物极度热爱，甚至产生戒断反应，失去这些事物后无法自拔。这种现象在网络上尤为常见，常常出现在社交网络骂战中。‌"
    }
  },
  "demos": {
    "1376": "小管家还会威胁你⁉⁉⁉匿名也能逮到啊⁉⁉",
    "229": "度度又在刷屏啊，找没找到我是小号的证据啊",
    "2531": "黑g还要考驾照，供非送的钱太多了吧，太恐怖了，要有猩司机了",
    "3448": "把自己小号暴露了",
    "4690": "这吧的都魔怔了喊不醒",
    "5676": "你不会真以为我是小号了吧，没见度度都不说话了吗",
    "5690": "基佬破防了，急得大号和小号说话",
    "5819": "要不要一起组队猎杀默和easygirl",
    "5998": "是被阿娜夺舍了吗我寻思着就阿娜这个水平应该也学不会盗号啊",
    "771": "兄弟们我上条冲错了，牛头怪是自己人，其他三个是真默🐶，冲另外三个默孝子"
  },
