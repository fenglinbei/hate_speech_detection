{
  "definitions": {
    "lex-0032:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "小仙女",
      "text": "在某些情况下被用来指代那些自私自利、双标、让人厌恶的女性。"
    },
    "lex-0068:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国男",
      "text": "“中国男性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；不等同于“中国男人”等普通完整表达中的任意两字片段，也不预设使用者的身份。"
    },
    "lex-0069:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国女",
      "text": "“中国女性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；具体语气取决于上下文，不预设使用者一定是男性。"
    },
    "lex-0112:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "基佬",
      "text": "'基'同粤语中'gay'的发音，对男同性恋群体的侮辱性表达。"
    },
    "lex-0185:sense:01": {
      "categories": [
        "Racism",
        "Sexism"
      ],
      "term": "eg",
      "text": "'eg'是'easy girl'的缩写，在中国常用于描述容易或主动与外国人发生性关系的女生。"
    },
    "lex-0438:sense:01": {
      "categories": [
        "others"
      ],
      "term": "老g",
      "text": "通常指的是'老家伙'或'老古董'，用于形容某人或某事物过时或老旧，常用于调侃或讽刺。"
    },
    "lex-0455:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "接盘侠",
      "text": "形容男人愿意接受女人复杂的情史、堕胎等行为，并愿意娶她为妻。"
    },
    "lex-0731:sense:01": {
      "categories": [
        "others"
      ],
      "term": "双标",
      "text": "对同一性质的事件或人，因主观偏好、利益等因素采用不同评判标准的行为‌。"
    }
  },
  "demos": {
    "1509": "EG都不是找那种老g吗。优秀的别人看不上",
    "2298": "你不后悔就好，如果他确实洁身自好品学兼优问题不大。不过你既然说出来了，少不得要有人评论，比如我思想上就接受不了这种事（虽然这是种族歧视，但是我确实歧视有狐臭的人，价值观定型了改不了的，仍然庆幸自己没被公知洗脑觉得外国更好，宁可做一个种族歧视者😅）你不用管评论里说什么，没有狐臭长得好品学兼优的外国人是可以谈恋爱的，但社会到了一个关键节点，迫切需要破除迷信权威，就比如今天拜登拉稀这件事，真假不重要，让美利坚成为笑话，挖苦他在金毛面前标记领地的行为，可以破除人们思想上的枷锁。如果不是激烈的反对劣质外国人，公知的声音就会占领舆论😆你要谈个小李子或者孔雀那个颜值的外国人，评论区将铺满酸柠檬并祝贺你为国争光，",
    "2682": "男的比女的多几千万呢！这些光棍当然要找外国女人，找中国的没有了啊。这叫双标吗？",
    "5616": "很明显火星人是人好吧？火星人名字都带人字了，选错的自己反省",
    "6114": "你急什么啊？好国男自然配好国女，你竞争不过好国男，又不想找eg，最后找了个越南🐵，还在这同情好国男呢？好国男表示，你谁啊？可别代表我，我手里没香蕉。哈哈哈。",
    "6658": "人家那是和全世界联系起来的，眼界比我们开阔多了，有这种优势哪个女的不想嫁给他们？",
    "6852": "小仙女不是说中国男人配不上中国女人吗？男人只好找外国女人了，合情合理",
    "718": "按照你的逻辑你可以和男人doi的，只是你不想罢了",
    "7464": "基佬的艾正常人也不会要，还谈什么勾引，真艾只属于基佬",
    "7959": "一位优秀的接盘侠👍👍"
  },
  "query": "为什么不找外星优质男人呢，人家有太空战舰呢",
