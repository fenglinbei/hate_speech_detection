{
  "definitions": {
    "lex-0032:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "小仙女",
      "text": "在某些情况下被用来指代那些自私自利、双标、让人厌恶的女性。"
    },
    "lex-0187:sense:01": {
      "categories": [
        "others"
      ],
      "term": "变态",
      "text": "用于描述心理方面不正常的群体，常含贬义。"
    },
    "lex-0287:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "黑蛆",
      "text": "对黑人群体的侮辱性用词。"
    },
    "lex-0441:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "人妖",
      "text": "泛指心理性别错位、男扮女装等非常态之人，含贬义。"
    },
    "lex-0562:sense:01": {
      "categories": [
        "others"
      ],
      "term": "魔怔",
      "text": "网络用语，指那些行为举止异常、情绪不稳定的现象，通常表现为对某些事物极度热爱，甚至产生戒断反应，失去这些事物后无法自拔。这种现象在网络上尤为常见，常常出现在社交网络骂战中。‌"
    },
    "lex-0669:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "批",
      "text": "在部分方言或粗俗表达中可作女性生殖器的俗称；“批评”“批判”以及普通批次或程度构式中的“批”不能直接套用这一义项。"
    }
  },
  "demos": {
    "3366": "这不是人妖，此乃糞坑黑变态的黑蛆",
    "4009": "想起你来了，你对象找找了吗",
    "4690": "这吧的都魔怔了喊不醒",
    "5024": "我二弟又被屏蔽了，你去别的地方发，这里的AI可是芭芭拉小魔仙的存在",
    "5529": "我去杭州玩 刚出铂丽酒店没一百米 可能因为我在和边上的同学用东北话交流 两个东北人真是罪大恶极 杭州警察立刻把我俩拦下来盘问并且要求查身份证 你要非得说没有歧视我也没招 我说的要是萧山话他会拦我们吗",
    "5708": "哪来的通讯录怪物",
    "5997": "哈哈哈，小仙女的事要你们管",
    "6569": "别批图啦，这图我都知道你从哪里偷来的",
    "7963": "你搁这发鬼图呢？",
    "966": "我猜你是浙江人~~"
  },
  "query": "我还在杭州等你呢，妖怪你在哪里？",
