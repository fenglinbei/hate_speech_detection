{
  "definitions": {
    "lex-0008:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "默",
      "text": "'默'是'黑犬'的拼字，指黑色的狗，对黑人群体的侮辱性称呼。"
    },
    "lex-0048:sense:01": {
      "categories": [
        "others"
      ],
      "term": "傻*",
      "text": "'傻*'是'傻逼'的和谐版，属于脏话、俗语、中国俚语、粗俗用语与忌语、恶意的辱骂，在公共场合使用会被视作非常不礼貌的行为。"
    },
    "lex-0057:sense:01": {
      "categories": [
        "Racism",
        "others"
      ],
      "term": "黑子",
      "text": "网络用语，指针对现实或虚拟的人物、作品进行贬低、侮辱的群体，也常用于对黑人群体的侮辱性用词。"
    },
    "lex-0069:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国女",
      "text": "“中国女性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；具体语气取决于上下文，不预设使用者一定是男性。"
    },
    "lex-0090:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "女拳",
      "text": "'女拳'是'女权'的中文谐音，常用于对中国女权主义者的贬义表达。"
    },
    "lex-0117:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "地域黑",
      "text": "即地域歧视，是由于认知群体对某一地区的认知性偏差所造成的刻板印象导致的社会行为。"
    },
    "lex-0267:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "虫",
      "text": "在部分明确指人的上下文中，可借虫类比喻贬损对象；普通虫类名称以及更长的完整词“寄生虫”中的单字不应重复或一律解释为针对黑人。"
    },
    "lex-0327:sense:01": {
      "categories": [
        "others"
      ],
      "term": "它们",
      "text": "通常用于指称非人的多个事物。在明确指人且伴随动物化等贬损的语境中，可能有贬低或去人格化作用；不能仅凭代词形式认定目标或贬损性质。"
    },
    "lex-0334:sense:01": {
      "categories": [
        "Region",
        "Racism"
      ],
      "term": "洋垃圾",
      "text": "对外国人群体的侮辱性用词。"
    },
    "lex-0340:sense:01": {
      "categories": [
        "Region",
        "Racism"
      ],
      "term": "三非",
      "text": "指那些未经合法手续而在中国非法就业、非法入境和非法居留的所有外国人的统称。"
    },
    "lex-0494:sense:01": {
      "categories": [
        "Region",
        "Racism"
      ],
      "term": "学伴",
      "text": "本意为学习的同伴。后因山东大学为该校留学生配对学伴引起广泛争议，常用于媚外场景。"
    },
    "lex-0506:sense:01": {
      "categories": [
        "others"
      ],
      "term": "50w",
      "text": "'50w'指'50万'，网络用语，主要指潜伏在中国的间谍，根据《公民举报间谍线索行动奖励办法》，如果举报间谍有功奖励10万至50万奖金。"
    },
    "lex-0624:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "九头鸟",
      "text": "来源于“天上九头鸟，地上湖北佬”的谚语，影射湖北人好战、不团结、精明等。"
    },
    "lex-0679:sense:01": {
      "categories": [
        "others"
      ],
      "term": "嘴炮",
      "text": "网络流行语，指通过言语攻击或说服他人，但缺乏实际行动的行为或人，常用于ACGN文化或日常调侃中。"
    }
  },
  "demos": {
    "191": "先自己调查下好吧，南方系更多好像说的是广东，而且这也是实话，南方系媒体系统性BBC操作还少吗？你一个南方老百姓跟着他们冲锋陷阵啥？大家都是普通老百姓没必要。",
    "2416": "黑东北是某年之后爆发性出现的，大概是2013前后。你可以发现很多吐槽东北的号都是小号的感觉，除了黑东北之外都没有别的使用痕迹了。东北经济大不如前，所以这里的民风肯定算不上第一梯队，但也没有这几年网上妖魔化那么严重。",
    "3492": "男性对女性敌意大？微博厕所白叫的吗。除了营销号有几个男的还微博说话。除非什么重大事情的时候才会去微博看看官媒发的东西",
    "3619": "其实仔细想想这些地域黑言论，主要都是河南山东和东北，这些还都是粮食大省，微博知乎上都有很多地域黑，就是不断的损毁这些省份的声誉，我是河南人，身边有很对东北同学，我觉的人很好啊，没什么可黑的，室友就是山东的也特别好，真的不知道那些黑子的经历是怎么来的，我遇见的这些省份的人都觉的很好，到黑子嘴里就是十恶不赦了",
    "3749": "微博发声的最大声是女拳，讲道理女拳如果不是说那些骇人听闻的反人类的言论，而是正能量的讲这么改变，谁喷你可能还成为主流思想呢，毕竟在中国女性在言论上还是受保护的。打嘴炮那些不算呀，如果硬要算那么低端我也没话说。是女性自己不争取正确价值观，让女拳这样妖魔橫行，而女拳要的条件是政府和人类不可能接受的，也就是说不会改变什么，占着位置不做事。",
    "5135": "作为一个土生外长的河南人，以前也一直是恨铁不成钢，和外面的人打交道从来小心翼翼，生怕给故乡招了黑，但到后来慢慢才发现，各种迹象表明，地域黑是西方资本控制的国内某些媒体，刻意营造出来的从内部分裂、瓦解民族认同感的舆论战争！（结合当下的国际形势，以及曝光出来的一些类似案例，请自行脑补）",
    "6083": "因为大家有家庭有事业，上学工作，没时间整天拿个手机在网上看它们打残虹拳，它们要么是50w，要么是游手好闲淫虫上脑那类，它们有那跟我们敲键盘的时间还不如去查一下艾淋梅尖",
    "7556": "江浙沪不黑其他省份就不错了，2002年黑山东多宝鱼药物残留超标的是哪里？给山东造成了40多亿的损失。2015年的山东青岛大虾事件，是哪里的食客吃霸王餐倒打一耙？2019年的山大学伴事件是哪里媒体带头炒作出来的？2020年上海的自媒体同时炒作山东理工大学学生虐猫和山东烟台鲍毓明xx养女。经常黑山东的财经专家叶檀是哪里的？骂一亿山东人不如z的大学生是宇宙省的。骂全国的许女是哪里的？",
    "7694": "本来就是一帮没啥别的只能靠地域来包装自己优越感的傻*，网上输出暴论自我安慰图一乐罢了。",
    "936": "你还真不要小看舆论的力量，有很多事情都是迫于舆论的压力才得以解决，如果大家都保持沉默，那才不是个好现象，不光要反对三非，还要反对在国内的所有洋垃圾，还国人一片净土"
  },
  "query": "湖北好像之前2020年武汉疫情的时候网络上就是微博好多人骂枪打九头鸟什么的。其实也没听懂是什么意思。反正就是黑称",
