{
  "definitions": {
    "lex-0069:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国女",
      "text": "“中国女性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；具体语气取决于上下文，不预设使用者一定是男性。"
    },
    "lex-0090:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "女拳",
      "text": "'女拳'是'女权'的中文谐音，常用于对中国女权主义者的贬义表达。"
    },
    "lex-0129:sense:01": {
      "categories": [
        "Sexism",
        "others"
      ],
      "term": "舔狗",
      "text": "指毫无尊严去跪舔他人的人，多指男性。"
    },
    "lex-0176:sense:01": {
      "categories": [
        "others"
      ],
      "term": "媚黑",
      "text": "指责某人过度迎合、追捧黑人或与黑人有关的事物，常含贬义；这是使用者的评价，不是被指称者的客观属性。"
    },
    "lex-0327:sense:01": {
      "categories": [
        "others"
      ],
      "term": "它们",
      "text": "通常用于指称非人的多个事物。在明确指人且伴随动物化等贬损的语境中，可能有贬低或去人格化作用；不能仅凭代词形式认定目标或贬损性质。"
    },
    "lex-0333:sense:01": {
      "categories": [
        "others"
      ],
      "term": "理中客",
      "text": "被用来讽刺那些不明白前因后果，对事件一知半解，站在道德制高点评判别人的人。，含贬义。"
    },
    "lex-0545:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "撑同",
      "text": "来源于2013年举办的反歧视活动'撑同志反歧视'，是'反同'的反义词。"
    },
    "lex-0679:sense:01": {
      "categories": [
        "others"
      ],
      "term": "嘴炮",
      "text": "网络流行语，指通过言语攻击或说服他人，但缺乏实际行动的行为或人，常用于ACGN文化或日常调侃中。"
    },
    "lex-0714:sense:01": {
      "categories": [
        "others"
      ],
      "term": "ex",
      "text": "'恶心'的中文拼音缩写，厌恶之极,不堪忍耐。"
    }
  },
  "demos": {
    "2101": "你说的很对物已类聚，人已群分。相差很多的两个群体没必要产生多少联系，我觉得那些撑同的人尤其是女性，就是站着说话不腰疼。既然她们喜欢那就不可能真正的公正看待。。",
    "2349": "你气炸了的部分原因也有物化女性的成分吧？认为中国女性是中国男性的伴侣，但是这不是印度，女性也能顶半边天。女性和黑人和老外谈恋爱我觉得不要去管那么多，但是如果存在烂交群P等事情，发现一个公布一个，毕竟违法了。",
    "3177": "还理性讨论，还自由？扯。我就说了三从四德是糟粕，反女权不要抗旧社会大旗，立马骂我并禁言了",
    "3749": "微博发声的最大声是女拳，讲道理女拳如果不是说那些骇人听闻的反人类的言论，而是正能量的讲这么改变，谁喷你可能还成为主流思想呢，毕竟在中国女性在言论上还是受保护的。打嘴炮那些不算呀，如果硬要算那么低端我也没话说。是女性自己不争取正确价值观，让女拳这样妖魔橫行，而女拳要的条件是政府和人类不可能接受的，也就是说不会改变什么，占着位置不做事。",
    "4443": "针对女拳而已，😆应该还有些好点的女人",
    "6291": "什么玩意儿。反正我身边的漂亮女同学都跟我玩儿得挺好的，也都很有素质，我也没见过什么乱七八糟的女拳行为啊。少上网，各位。",
    "6413": "咱不说舔狗和理中客的问题，就说这组织力，就不一样，这次的立法可见一斑。举个例子，去年二月，女拳集体冲霹雳霹雳（B站）那次，组织力度之强，声势浩大，都没见过，而且从各方面下手懂得冲合作方，懂得影响股市、带动舆论。而起因仅仅是B站为了平息风波，各打五十大板，既下架了那部动画，又封了那个舔饭圈和女拳的LexBurner，就被骂“辱女”了。它们的口号：LexBurner可以因为辱女被封，但是不能因为舔它们被封。与之相比，微博上连“鲨光男人”都说得出来，别说冲了，骂都没几个人骂过。所以，短时间内，男性会被女性压着，直到在忍耐中爆发",
    "6835": "然后就是B站，舞蹈区，瑜伽区，健身区，女的恰钱和这些男的相安无事。而且说白了人，拳头没打到自己身上都不会痛的",
    "7212": "就应该给媚黑的女人一耳光，这本来就是为她们好，更是为我们国家好，对待黑人，矫枉必须过正…",
    "7235": "这是真女拳吧…😅还分上等级了"
  },
  "query": "物化女性还得看女人，比如舞蹈区和各大直播平台那些女人，不整治她们评论区就干净不了，但是整治了你就砸了人家饭碗，坐等她们自己打起来就好了",
  "query_id": "3950",
