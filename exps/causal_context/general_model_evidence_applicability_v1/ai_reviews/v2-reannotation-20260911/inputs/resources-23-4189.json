{
  "definitions": {
    "lex-0090:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "女拳",
      "text": "'女拳'是'女权'的中文谐音，常用于对中国女权主义者的贬义表达。"
    },
    "lex-0092:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "女拳王",
      "text": "常用于对中国女权主义者的贬义表达。"
    },
    "lex-0176:sense:01": {
      "categories": [
        "others"
      ],
      "term": "媚黑",
      "text": "指责某人过度迎合、追捧黑人或与黑人有关的事物，常含贬义；这是使用者的评价，不是被指称者的客观属性。"
    },
    "lex-0215:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "男同",
      "text": "对男同性恋群体的简称，常含贬义。"
    },
    "lex-0343:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "骗婚",
      "text": "同性恋者隐瞒自己性取向，步入异性恋婚姻的行为。"
    },
    "lex-0603:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "美国佬",
      "text": "对美国人的调侃性称呼。"
    },
    "lex-0749:sense:01": {
      "categories": [
        "others"
      ],
      "term": "狗东西",
      "text": "骂人的话。"
    }
  },
  "demos": {
    "1158": "女拳真是典中典?",
    "2025": "已经完全失去了对中国年轻女性的信任（35以下），反正我现在看任何一个我不是很熟的年轻女的都先贴上两个标签 女拳王 媚黑，就像女的说男的都是潜在强奸犯一样，互相戴帽子呗，两性之间的信任会越来越少，直至完全对立🤔",
    "2075": "原来女性的地位由男同决定?你这个思想属实搞笑，对于男同仇女确实有，但是我觉得大多数不会，还有你不会以为抵制男同就没有男同了吧，男同事基因，不是后天学习，打压男同只会有更多的男同因为社会压力骗婚，这道理都不懂。",
    "2685": "所以当前突出问题也包括女汉奸的问题，这点这个🐶的贴已经说明了",
    "3212": "一直就有大把女人反对女拳，现实中女拳并不多，大多混迹在网络",
    "3372": "女权怼了女拳？这事儿女拳知道吗？?",
    "4443": "针对女拳而已，😆应该还有些好点的女人",
    "4810": "女权背后打拳替美国佬办事的狗东西可不少，把黑人娶进来的咋不说呢",
    "6291": "什么玩意儿。反正我身边的漂亮女同学都跟我玩儿得挺好的，也都很有素质，我也没见过什么乱七八糟的女拳行为啊。少上网，各位。",
    "7235": "这是真女拳吧…😅还分上等级了"
  },
  "query": "😓早就听闻不少男的假冒女拳败坏我国大部分女性形象，今日一见，果真如此",
