{
  "definitions": {
    "lex-0073:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "txl",
      "text": "中文'同性恋'拼音的首字母简写，用于代指同性恋群团。"
    },
    "lex-0080:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "公交车",
      "text": "在部分性别贬损语境中，以可供多人乘坐的交通工具比喻女性与多人发生过性关系，对其污名化；这些是说话者的贬损指控，不是对女性行为或品格的事实认定。"
    },
    "lex-0080:sense:02": {
      "categories": [
        "Sexism"
      ],
      "term": "公交车",
      "text": "也存在不限定女性对象的类似性关系污名化用法；应结合所指对象判断，普通交通工具含义不属于贬损义。"
    },
    "lex-0108:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "lkd",
      "text": "'lkd'是'烂裤裆'的首字母缩写，对一些私生活不检点甚至糜烂的女人的侮辱性表达。"
    },
    "lex-0185:sense:01": {
      "categories": [
        "Racism",
        "Sexism"
      ],
      "term": "eg",
      "text": "'eg'是'easy girl'的缩写，在中国常用于描述容易或主动与外国人发生性关系的女生。"
    },
    "lex-0191:sense:01": {
      "categories": [
        "others"
      ],
      "term": "nt",
      "text": "'nt'是'脑瘫'的中文拼音首字母缩写，用于讽刺有关人物智力低下，反应迟钝，或者存在神经功能障碍。"
    },
    "lex-0212:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "江浙人种",
      "text": "由于江苏浙江为经济发达地区，部分江浙人对经济欠发达地区存在地域歧视，'江浙人种'为其余地区对这部分人的讽刺性称呼。"
    },
    "lex-0380:sense:01": {
      "categories": [
        "Racism",
        "Sexism"
      ],
      "term": "白楠",
      "text": "'白楠'是'白男'中文谐音，常用于对白种人男性的讽刺性称呼。"
    },
    "lex-0427:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "嘿玩意",
      "text": "'嘿玩意'是'黑玩意'的中文谐音，对黑人群体的侮辱性称呼。"
    },
    "lex-0454:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "接盘",
      "text": "形容男人愿意接受女人复杂的情史、堕胎等行为，并愿意娶她为妻。"
    },
    "lex-0484:sense:01": {
      "categories": [
        "others"
      ],
      "term": "cjb",
      "text": "网络用语，多含讽刺意，多用于表达名不副实的意思。"
    }
  },
  "demos": {
    "159": "还有我们🐶“江浙人种最高贵”（看不懂这句话语气是自黑还是嘲讽还是自以为是的就要来评论对枪的直接拉黑）",
    "1729": "主页整天搁那和不同的白楠yy，就算你真的那么有钱也不妨碍你lkd",
    "2535": "当个txl还光荣起来了，一边喊别歧视，一边四处发情。。你们不到别人的圈子发癫，人家会理你？",
    "3281": "编乎有几个真的，不全是cjb",
    "3612": "rush，增加kuai感的",
    "5425": "滚，lkd",
    "6629": "我怀疑你还活在梦里全世界著名的公交车eglkd还以为自己受欢迎有人高价接盘现在是你们想嫁都没愿意娶的",
    "7678": "这不正是你们这帮lj的写照吗？自己不接受的事物就要怱悠别人都来反对，还自以为很正义～",
    "7819": "带头的属于是恰烂钱的，跟风的就是铁nt",
    "7836": "都是一些歪瓜裂枣的LKD"
  },
  "query": "嘿玩意只热爱人民币和LKD的标子",
