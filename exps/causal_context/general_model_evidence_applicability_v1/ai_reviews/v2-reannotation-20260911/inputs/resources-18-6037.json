{
  "definitions": {
    "lex-0037:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "幕刃",
      "text": "'幕刃'是'母人'的中文谐音，是对女性群体的侮辱性用词。"
    },
    "lex-0069:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国女",
      "text": "“中国女性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；具体语气取决于上下文，不预设使用者一定是男性。"
    },
    "lex-0174:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "棒畜",
      "text": "'棒子'的衍生词，对韩国人的侮辱性用词。"
    }
  },
  "demos": {
    "2655": "很难不赞同，不过补充一点，杨靖宇将军是河南的，本名马尚德，驻马店的骄傲🍉",
    "3194": "你的截图说的很有道理",
    "3529": "哈哈估计自身条件非常烂只能靠出卖同性获得幕刃的关注了",
    "478": "u1s1，那个图片里对女人的解读基本没什么毛病，如果你觉得不对，那么请在五千年人类史中举出反例",
    "5230": "这里部分哪里是臆想，一个存在命题而已，【存在】华工在法国获得了法国女性的青睐，这样子表述你依旧认为不完备吗？",
    "528": "骂棒畜是一回事，骂幕刃又是另一回事",
    "5408": "幕刃是这样的",
    "5507": "幕刃不值得同情",
    "6469": "批评干嘛，求仁得仁又何求！求黑得黑，与黑长存嘛",
    "877": "泼图的意义？以诙谐、从容的形式让同性恋们认知到我们处于优势地位的事实"
  },
