    "lex-0073:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "txl",
      "text": "中文'同性恋'拼音的首字母简写，用于代指同性恋群团。"
    },
    "lex-0282:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "母畜",
      "text": "指雌性畜生，对女性群体的侮辱性称呼。"
    }
  },
  "demos": {
    "1180": "这就是你们txl的好队友吗？",
    "1456": "上广东待几天就看到了",
    "1986": "真的一上知乎全都是骂的，从女权骂到了女性，然而在现实生活中根本见不着，是我层次太低？",
    "2218": "没见过，只是他说“朋友说新疆人拿刀砍人很正常”我就回了这么一句",
    "2945": "这也能遇到你",
    "3081": "请问你是自己见过，还是经历过？",
    "3456": "不是你们先来碰瓷的？????",
    "387": "一眼真，也就母畜能干得出来这种事",
    "6282": "哈哈是啊我还记得在香港重庆大厦那些各种好闻的香料和难闻的体味混杂让人恍惚到了伊斯坦布尔的经历，，，不得不承认上帝造人太公平，让印巴人种有深潭一样美丽的眼睛和脸部轮廓但就是不能让人近身，，，，，",
    "7247": "让我看看你长啥样"
  },
  "query": "你见过吗？",
