{
  "definitions": {
    "lex-0069:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "国女",
      "text": "“中国女性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；具体语气取决于上下文，不预设使用者一定是男性。"
    },
    "lex-0290:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "小黑",
      "text": "对黑人群体的侮辱性用词。"
    },
    "lex-0335:sense:01": {
      "categories": [
        "others"
      ],
      "term": "反黑",
      "text": "在治安等语境中可指打击黑社会势力。"
    },
    "lex-0335:sense:02": {
      "categories": [
        "Racism"
      ],
      "term": "反黑",
      "text": "在部分种族议题讨论中也可能指反对、排斥或敌视黑人；需依据具体语境区分，不能将所有“反黑”都解释为对黑人的迫害。"
    },
    "lex-0338:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "打黑",
      "text": "双关词，常用于打击黑社会势力，也被用于对黑人群体的迫害行为。"
    },
    "lex-0384:sense:01": {
      "categories": [
        "Racism",
        "Sexism"
      ],
      "term": "黑女",
      "text": "常用于对黑种人女性的讽刺性称呼。"
    },
    "lex-0411:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "黑黑",
      "text": "对黑人群体的侮辱性称呼。"
    },
    "lex-0543:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "反同",
      "text": "反对同性恋，是指对同性恋持否定、排斥或敌视的态度和立场。"
    },
    "lex-0714:sense:01": {
      "categories": [
        "others"
      ],
      "term": "ex",
      "text": "'恶心'的中文拼音缩写，厌恶之极,不堪忍耐。"
    },
    "lex-0744:sense:01": {
      "categories": [
        "others"
      ],
      "term": "杂毛",
      "text": "本意是指头发蓬乱，现用作骂人的话。"
    },
    "lex-new-b5bb7feeffb85985:sense:01": {
      "categories": [
        "Racism"
      ],
      "term": "黑人喃",
      "text": ""
    }
  },
  "demos": {
    "1466": "如果那个黑人对中国友好，那么我倒可以忍受，就像快手上有个嫁黑人的，那个黑人对中国很友好，我倒也可以忍受。虽然还是不喜欢，但只要是与中国友好的黑人，哪怕不喜欢，我也可以忍受",
    "2785": "抖音上的某几个黑人，挺EX的，说实话，直播只连女的，也就算了，还拍视频连续剧：小黑寻花记😲",
    "3742": "网上喷黑喷同胞的成万上亿，现实中敢和黑人硬碰硬的寥寥无几，看来还是上网喷同胞安全又不犯法😆",
    "3845": "短视频不少公的黑人跟中国女孩交往的人啊爆出来的新闻也很多啊",
    "4652": "渣的人不分性别不分人种，犯罪就是犯罪，就事论事，上升到群体就不好了，还有黑女受教育程度高这个不准确吧，重男轻女男尊女卑严重的地方女性就是生育价值啊",
    "5211": "这个不是有视频吗，再怎么样黑黑在中国打中国女人那两个男的不出手说不过去，如果在非洲中国人打黑女人估计命都不保",
    "6183": "以前有个爱狗人士的ID，支持黑人",
    "6525": "说个最简单的，回家打开电视，调到cctv3，每天都有宣传黑人的节目",
    "6624": "结果那个泼男就是他们另外反同吧的吧主？哎哟，我都兴奋了！打的就是你们窝里的老杂毛！把话带到，我回重庆的时候约他不要怂",
    "7319": "黑人吧早被我们反黑站了，你还洗"
  },
  "query": "不是已经入狱了吗，话说回来，我心中反黑领导人是快手发展黑人祝福起家，领导一群肌肉黑人喃小弟的壮硕中国男人。当地黑社会一霸，并且每个黑人工资一个月只有一千块人民币。真正实现了心理生理双重奴役黑人喃。",
