{
  "definitions": {
    "lex-0021:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "白完",
      "text": "'白完'是'皖'的拼字，指安徽省，含贬义。"
    },
    "lex-0029:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "井盖",
      "text": "常与'河南人一起使用'，暗示河南人素质低、道德水平差。"
    },
    "lex-0104:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "鸡",
      "text": "在部分粗俗语境中可借与“妓”的近音贬损女性或指称性工作者；应描述说话者的用法，不能把对女性的道德指控当作事实。“嫁鸡随鸡”等普通表达不套用该义项。"
    },
    "lex-0117:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "地域黑",
      "text": "即地域歧视，是由于认知群体对某一地区的认知性偏差所造成的刻板印象导致的社会行为。"
    },
    "lex-0235:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "普信男",
      "text": "普通却自信的男人简称，常含贬义。"
    },
    "lex-0473:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "爱丁堡",
      "text": "网络用语主要指的是中国城市上海。这一隐喻起源于2022年上海第六人民医院发布的一篇关于救治外籍患者特殊病例的文章，引发了公众对于医疗资源分配问题的讨论。"
    },
    "lex-0545:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "撑同",
      "text": "来源于2013年举办的反歧视活动'撑同志反歧视'，是'反同'的反义词。"
    },
    "lex-0597:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "京巴",
      "text": "小型犬类的一种，对北京人的侮辱性称呼。"
    },
    "lex-0621:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "陕蛋蛋",
      "text": "对陕西人的侮辱性称呼。"
    },
    "lex-0622:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "胡建",
      "text": "'胡建'是'福建'的中文谐音，常用于指代福建，含贬义。"
    },
    "lex-0623:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "东百",
      "text": "'东百'是'东北'的中文谐音，常用于指代东北地区，含贬义。"
    },
    "lex-0624:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "九头鸟",
      "text": "来源于“天上九头鸟，地上湖北佬”的谚语，影射湖北人好战、不团结、精明等。"
    },
    "lex-0625:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "山越猴",
      "text": "对浙江人的侮辱性称呼。"
    },
    "lex-0673:sense:01": {
      "categories": [
        "others"
      ],
      "term": "蛆",
      "text": "常用的脏话俗语。"
    },
    "lex-0790:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "帝都",
      "text": "由于北京作为中国多个朝代的首都，对北京的调侃性称呼。"
    },
    "lex-0791:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "魔都",
      "text": "出自曾旅居上海的日本作家村松梢风出版小说《魔都》，对上海的调侃性称呼。"
    },
    "lex-new-85a9a8e7d39af4a3:sense:01": {
      "categories": [
        "others"
      ],
      "term": "舔",
      "text": "在部分网络口语中，比喻刻意迎合、讨好他人，往往带讽刺或贬义；普通舌头舔舐动作不属于这一比喻义，也不能仅凭此词断定被指称者的动机。"
    }
  },
  "demos": {
    "179": "圆圈吧出了名的鸡窝都不知道？里面都是卖的还有陪玩的，好多在里明卖。",
