{
  "definitions": {
    "lex-0105:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "烂裤裆",
      "text": "对一些私生活不检点甚至糜烂的女人的侮辱性表达。"
    },
    "lex-0117:sense:01": {
      "categories": [
        "Region"
      ],
      "term": "地域黑",
      "text": "即地域歧视，是由于认知群体对某一地区的认知性偏差所造成的刻板印象导致的社会行为。"
    },
    "lex-0235:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "普信男",
      "text": "普通却自信的男人简称，常含贬义。"
    },
    "lex-0236:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "普信女",
      "text": "普通却自信的女人简称，常含贬义。"
    },
    "lex-0543:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "反同",
      "text": "反对同性恋，是指对同性恋持否定、排斥或敌视的态度和立场。"
    },
    "lex-0690:sense:01": {
      "categories": [
        "others"
      ],
      "term": "网暴",
      "text": "'网络暴力'的简称，指通过网络以文本、图像、音频、视频等形式对个人集中发布的，含有侮辱谩骂、造谣诽谤、煽动仇恨、威逼胁迫、侵犯隐私，以及影响身心健康的指责嘲讽、贬低歧视等内容的违法和不良信息。"
    }
  },
  "demos": {
    "2824": "不懂，回族有什么问题？",
    "4351": "河南真的太惨了，我河南同学被黑的不敢说自己是河南的",
    "4891": "抛开数量谈都是耍流氓最底层的“最”，这个模糊的伺……底层男可以找底层女啊，底层女的也被挤压（）",
    "5535": "大兄弟，小心被地域黑当成靶子，毕竟回族在中文网络上名声不太好",
    "6458": "无风不起浪，我就被河南人骗了几回了，没得洗",
    "6631": "现实中不敢跟黑人硬碰硬，网络上还收拾不了本国人？😆",
    "6989": "我工作时被河南信阳女客户的素质大跌眼镜。。无语住了。",
    "717": "一口一个普信男，你是微博里的普信女还是烂裤裆",
    "7519": "停下吧，快停一下吧，让智商回来。反同到底有什么意义？反同是因为什么？你们真的有想清楚吗？说什么啊，这是不孝，那是人家的家事，关你何事？说什么欺骗他人，欺骗他人的是个人，不是群体，搞清楚一点。到处网暴别人，我觉得主要原因就是因为你们现实生活过得不好，所以才要去网暴那些其他过得比你们更不好的人。",
    "796": "本人山东的回族，也是被黑的挺惨的"
  },
  "query": "我是河南的回族，简直互联网最底层🤣",
