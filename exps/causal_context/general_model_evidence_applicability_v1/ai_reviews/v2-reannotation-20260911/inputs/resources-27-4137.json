{
  "definitions": {
    "lex-0090:sense:01": {
      "categories": [
        "Sexism"
      ],
      "term": "女拳",
      "text": "'女拳'是'女权'的中文谐音，常用于对中国女权主义者的贬义表达。"
    },
    "lex-0215:sense:01": {
      "categories": [
        "LGBTQ"
      ],
      "term": "男同",
      "text": "对男同性恋群体的简称，常含贬义。"
    },
    "lex-0292:sense:01": {
      "categories": [
        "LGBTQ",
        "others"
      ],
      "term": "真“艾”",
      "text": "'真“艾”'是'真爱'的中文谐音，常用于对同性恋群体或艾滋病群体的贬义表达。"
    },
    "lex-0731:sense:01": {
      "categories": [
        "others"
      ],
      "term": "双标",
      "text": "对同一性质的事件或人，因主观偏好、利益等因素采用不同评判标准的行为‌。"
    }
  },
  "demos": {
    "2787": "那倒也没有，我觉得女的接受度更高。毕竟百合向大多数读者也是女性。就算不看，我看她们很多也对同性恋博主持友好态度。也有接受不了双标的，相对来说吧。不过这种一般会被人批评😅",
    "3680": "在姬圈有个别人还觉得“和男的睡过的女的都很脏”也挺无语的",
    "4299": "扯吧，微博豆瓣小红书哪个不是女性的天下",
    "467": "毕竟同性是真“艾”",
    "5330": "只能说物以类聚吧，至少我身边的女孩子都是这样，甚至还会觉得他们（黑和白）味道很大😭",
    "6291": "什么玩意儿。反正我身边的漂亮女同学都跟我玩儿得挺好的，也都很有素质，我也没见过什么乱七八糟的女拳行为啊。少上网，各位。",
    "6764": "其实在早些年，有个外国学家做过一篇调查的发现的是男人更支持女同婚姻，女人更支持男同婚姻",
    "7189": "希望你们都能花钱娶女同",
    "7394": "3女同还是一个系列的的片",
    "7661": "层主是女性反串的吗"
  },
  "query": "女圈有不少女同",
  "query_id": "4137",
