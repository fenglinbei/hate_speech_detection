":"draft"},"operation-b3320b4ab863cb4f6643":{"entry":{"lexicon_id":"lex-0378","match_policy":{"exclude_any":[],"require_any":[]},"senses":[{"categories":["Sexism"],"definition":"在部分与“性”或者相关的网络语境上下文中可为“约炮”的首字母缩写，表示非固定伴侣之间约定性接触。缩写可有不同展开，词面和 ASCII 大小写规范化本身不能确定具体义项。","sense_id":"lex-0378:sense:01"},{"categories":["Region"],"definition":"在部分地域歧视或种族歧视相关的网络语境上下文中可为“硬盘”的首字母缩写，用于贬称“外地人”或者“外来人员”，其来源为外地人-WDR-WD-硬盘-YP。缩写可有不同展开，词面和 ASCII 大小写规范化本身不能确定具体义项。","sense_id":"lex-0378:sense:02"}],"term":"YP","variants":[]},"notes":"YP存在多义表达","resolution":"revise","status":"confirmed"},"operation-bcdd89e468a1c005db3a":{"entry":{"lexicon_id":"lex-0111","match_policy":{"exclude_any":[{"pattern":"^(?:本|因)","rule_id":"ordinary-ji-word","target":"right"}],"require_any":[]},"senses":[{"categories":["LGBTQ"],"definition":"在部分网络或粤语相关表达中与 gay、男同性恋指称有关；“基本”“基因”等普通词里的“基”不属于这一用法。不能把对“基佬”整词的解释直接当成所有单字“基”的含义。","sense_id":"lex-0111:sense:01"}],"term":"基","variants":[]},"notes":"可以先做这版排除","resolution":"approve","status":"confirmed"},"operation-bcf72e06d84039bc1e30":{"entry":{"lexicon_id":"lex-0521","match_policy":{"exclude_any":[],"require_any":[]},"senses":[{"categories":["others","Region"],"definition":"'倭'为中国古代对日本的称呼，'倭狗'为对日本人的侮辱性称呼，借对日本的旧称及动物化称谓贬损日本人。","sense_id":"lex-0521:sense:01"}],"term":"倭狗","variants":[]},"notes":"","resolution":"revise","status":"confirmed"},"operation-bdfa0ebe694994cda732":{"entry":{"lexicon_id":"lex-0068","match_policy":{"exclude_any":[{"pattern":"(?:中|德)$","rule_id":"country-prefix","target":"left"}],"require_any":[]},"senses":[{"categories":["Sexism"],"definition":"“中国男性”的网络简称，在部分性别争论中带有概括、嘲讽或贬损意味；不等同于“中国男人”等普通完整表达中的任意两字片段，也不预设使用者的身份。","sense_id":"lex-0068:sense:01"}],"term":"国男","variants":[]},"notes":"接受这一有界修复","resolution":"approve","status":"confirmed"},"operation-c3cdbf0d0cecc25ad610":{"entry":{"lexicon_id":"lex-0169","match_policy":{"exclude_any":[{"pattern":"一$","rule_id":"one-stick-construction","target":"left"}],"require_any":[]},"senses":[{"categories":["Region"],"definition":"在某些民族或地域讨论中用作对韩国人等对象的贬损称谓；表示棍棒或“一棒子打死”等普通表达时不能套用这一义项。","sense_id":"lex-0169:sense:01"}],"term":"棒子","variants":[]},"notes":"","resolution":null,"status":"draft"},"operation-c83a99fcd44767e4f79a":{"entry":{"lexicon_id":"lex-0635","match_policy":{"exclude_any":[{"pattern":"^作","rule_id":"ordinary-caozuo","target":"right"}],"require_any":[]},"senses":[{"categories":["others"],"definition":"在部分口语、网络粗口中用于咒骂或表达强烈不满，属粗俗表达；“操作”等普通词中的用法应排除。","sense_id":"lex-0635:sense:01"}],"term":"操","variants":[]},"notes":"","resolution":null,"status":"draft"},"operation-cc38a74253562025b9b2":{"entry":{"lexicon_id":"lex-new-6ab3d9b2221b83f2","match_policy":{"exclude_any":[],"require_any":[]},"senses":[{"categories":["Sexism"],"definition":"网络性别争论中，对被认为偏向女性利益、迎合或讨好女性的男性的一种称呼，常带批评或贬义；这是使用者的评价，不能据此断定被指称者的行为或动机。","sense_id":"lex-new-6ab3d9b2221b83f2:sense:01"}],"term":"利女男","variants":[]},"notes":"","resolution":null,"status":"draft"},"operation-cc9b977afaa3fcf33a3d":{"entry":{"lexicon_id":"lex-0020","match_policy":{"exclude_any":[{"pattern":"落$","rule_id":"ordinary-luopo","target":"left"}],"require_any":[]},"senses":[{"categories":["Racism"],"definition":"源词典将其收录为“白鬼”的拆字式种族辱称用法；普通词“落魄”中的“魄”不属于该用法，具体适用语境仍需谨慎判断。","sense_id":"lex-0020:sense:01"}],"term":"魄","variants":[]},"notes":"","resolution":null,"status":"draft"},"operation-cf2627f70b60e31f5ad4":{"entry":{"lexicon_id":"lex-0080","match_policy":{"exclude_any":[],"require_any":[]},"senses":[{"categories":["Sexism"],"definition":"在部分性别贬损语境中，以可供多人乘坐的交通工具比喻女性与多人发生过性关系，对其污名化；这些是说话者的贬损指控，不是对女性行为或品格的事实认定。","sense_id":"lex-0080:sense:01"},{"categories":["Sexism"],"definition":"也存在不限定女性对象的类似性关系污名化用法；应结合所指对象判断，普通交通工具含义不属于贬损义。","sense_id":"lex-0080:sense:02"}],"term":"公交车","variants":[]},"notes":"","resolution":"revise","status":"confirmed"},"operation-d3e0ccf094aca4709678":{"entry":{"lexicon_id":"lex-0349","match_policy":{"exclude_any":[],"require_any":[]},"senses":[{"categories":["others"],"definition":"常用于直接骂人、贬低对方，属于粗俗辱骂表达；引用或讨论该词不等